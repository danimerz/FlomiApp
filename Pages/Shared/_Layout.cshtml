@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment
@inject IConfiguration Configuration
@{
    var designTheme = FlomiApp.Helpers.DesignTheme.FromConfiguration(Configuration);
    var themeStylesheet = FlomiApp.Helpers.DesignTheme.StylesheetPath(designTheme);
}
@inject Microsoft.AspNetCore.Identity.SignInManager<FlomiApp.Data.Models.ApplicationUser> SignInManager
<!DOCTYPE html>
<html lang="de" data-brand="@designTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@FlomiApp.Helpers.SeoHelper.FullTitle(ViewData["Title"] as string)</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? FlomiApp.Helpers.SeoHelper.DefaultDescription)" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    @if (themeStylesheet != null)
    {
        <link rel="stylesheet" href="~/@themeStylesheet" asp-append-version="true" />
    }
    <meta name="theme-color" content="@FlomiApp.Helpers.DesignTheme.ThemeColor(designTheme)" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/icon-192.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true" />
</head>
<body>

    <nav class="flomi-nav">
        <div class="flomi-nav__inner">
            <a class="flomi-nav__brand" href="/">FlomiApp</a>

            <div class="flomi-nav__links">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="flomi-nav__link" href="/user/dashboard">Dashboard</a>
                    <form method="post"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          style="display:inline;">
                        <button type="submit" class="flomi-nav__link flomi-nav__link--btn">Logout</button>
                    </form>
                }
                else
                {
                    <a class="flomi-nav__link" href="/Identity/Account/Login">Login</a>
                    <a class="flomi-nav__link" href="/Identity/Account/Register">Registrieren</a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer style="text-align:center;padding:2rem 1rem 1rem;font-size:.82rem;color:#94a3b8;">
        <a href="/datenschutz" style="color:#94a3b8;text-decoration:none;">Datenschutz</a>
        <span style="opacity:.6;"> · </span>
        <a href="/impressum" style="color:#94a3b8;text-decoration:none;">Impressum</a>
        <span style="display:block;margin-top:.3rem;">Version @FlomiApp.Helpers.AppVersion.Display</span>
    </footer>

    <script src="~/Identity/lib/jquery/dist/jquery.js"></script>
    <script src="~/Identity/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>