            </div>

            <div class="av-modal__footer">
                <button type="button" class="av-submit-btn" @onclick="SaveCell" disabled="@isSaving">
                    @(isSaving ? "⏳ Wird gespeichert..." : cellExists ? "💾 Speichern" : "📌 Einteilen")
                </button>
                @if (cellExists)
                {
                    <button type="button" class="av-btn av-btn--delete" @onclick="RemoveCell" disabled="@isSaving">
                        @(cellConfirmRemove ? "🗑️ Wirklich entfernen?" : "🗑️ Tag entfernen")
                    </button>
                }
                <button type="button" class="av-cancel-btn" @onclick="CloseCell">Abbrechen</button>
            </div>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════════════════════
     MODAL — NEUES FAHRZEUG (aus dem Einsatzplan)
════════════════════════════════════════════════════════════════════════════ -->
@if (showNewVehicleModal)
{
    <div class="av-modal-backdrop" @onclick="() => showNewVehicleModal = false">
        <div class="av-modal av-modal--narrow" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="newveh-title">
