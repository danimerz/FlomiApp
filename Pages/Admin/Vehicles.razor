                        @(isSaving ? "⏳ Wird gespeichert..." : "✅ Fahrzeug erfassen")
                    </button>
                    <button type="button" class="av-cancel-btn" @onclick="() => showNewVehicleModal = false">Abbrechen</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    // ── Enums ─────────────────────────────────────────────────────────────────
    private enum Tab { Plan, Vehicles, Route }
    private Tab activeTab = Tab.Plan;

    // ── Data ──────────────────────────────────────────────────────────────────
    private List<Vehicle>?                vehicles        = null;
    private List<VehicleAssignment>?      assignments     = null;
    private List<Event>?                  events          = null;
    private List<ApplicationUser>?        users           = null;
    private List<FurniturePickupRequest>? pickupRequests  = null;

    // ── Route Planning ────────────────────────────────────────────────────────
    private int                       routeEventId      = 0;
    private DateTime?                 routeDate         = null;
    private string                    routeStartAddress = "";
    private FurniturePickupSettings?  routeSettings     = null;
    private bool                      isPlanning         = false;
    private bool                      isExportingRoute   = false;
    private RoutePlanningResult?      planResult         = null;
    private bool                      hasSampleData      = false;
    private bool                      isSampleBusy       = false;

    private IEnumerable<FurniturePickupRequest> RoutePickups =>
        (pickupRequests ?? new())
        .Where(r => r.Status == PickupRequestStatus.Accepted)
        .Where(r => routeEventId == 0 || r.EventId == routeEventId)
        .Where(r => routeDate == null || r.PickupDate.Date == routeDate.Value.Date)
        .OrderBy(r => r.PostalCode)
        .ThenBy(r => r.Street);

    private List<DateTime> RouteAvailableDates =>
        (pickupRequests ?? new())
        .Where(r => r.Status == PickupRequestStatus.Accepted)
        .Where(r => routeEventId == 0 || r.EventId == routeEventId)
        .Select(r => r.PickupDate.Date)
        .Distinct()
        .OrderBy(d => d)
        .ToList();

    private List<Vehicle> VehiclesOnRouteDay =>
        routeDate == null ? new() :
        (assignments ?? new())
        .Where(a => (routeEventId == 0 || a.EventId == routeEventId)
                 && a.AssignedDates.Any(d => d.Date.Date == routeDate.Value.Date))
        .GroupBy(a => a.VehicleId)
        .Select(g => g.First().Vehicle)
        .Where(v => v != null)
        .ToList()!;

    private string BuildMapsUrl()
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(routeStartAddress))
            parts.Add(Uri.EscapeDataString(routeStartAddress.Trim()));
        parts.AddRange(RoutePickups.Select(r => Uri.EscapeDataString($"{r.Street}, {r.PostalCode} {r.City}")));
        return "https://www.google.com/maps/dir/" + string.Join("/", parts);
    }

    private string BuildVehicleMapsUrl(int vehicleId)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(routeStartAddress))
            parts.Add(Uri.EscapeDataString(routeStartAddress.Trim()));
        parts.AddRange(RoutePickups
            .Where(r => r.AssignedVehicleId == vehicleId)
            .OrderBy(r => r.RouteStopOrder ?? int.MaxValue)
            .ThenBy(r => r.PostalCode)
            .Select(r => Uri.EscapeDataString($"{r.Street}, {r.PostalCode} {r.City}")));
        // Zurück zur Startadresse zum Abladen
        if (!string.IsNullOrWhiteSpace(routeStartAddress))
            parts.Add(Uri.EscapeDataString(routeStartAddress.Trim()));
        return "https://www.google.com/maps/dir/" + string.Join("/", parts);
    }

    private async Task OnRouteEventChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            routeEventId = id;
        routeDate = null;
        await LoadRouteSettingsAsync();
    }

    private async Task LoadRouteSettingsAsync()
    {
        if (routeEventId > 0)
        {
            // Startadresse auch übernehmen, wenn der Abholservice (noch) nicht aktiv ist
            routeSettings     = (await FurniturePickupService.GetAllSettingsAsync())
                                .FirstOrDefault(s => s.EventId == routeEventId);
            routeStartAddress = routeSettings?.DepartureAddress ?? "";
        }
        else
        {
            routeSettings     = null;
            routeStartAddress = "";
        }
    }

    // Ergebnis gilt nur für den Tag/Event, für den geplant wurde
    private (int EventId, DateTime? Date) planKey;
    private RoutePlanningResult? CurrentPlan =>
        planResult != null && planKey == (routeEventId, routeDate) ? planResult : null;

    private async Task PlanRoutes(RoutePlanMode mode)
    {
        if (!routeDate.HasValue) return;
        if (string.IsNullOrWhiteSpace(routeStartAddress))
        {
            planResult = RoutePlanningResult.Failed("Bitte zuerst eine Startadresse eingeben (z.B. «Gewerbestrasse 1, 6314 Unterägeri»).");
            planKey    = (routeEventId, routeDate);
            return;
        }

        isPlanning = true;
        try
        {
            planResult = await RoutePlanningService.PlanAsync(
                routeEventId > 0 ? routeEventId : null,
                routeDate.Value,
                routeStartAddress,
                VehiclesOnRouteDay.Select(v => v.Id).ToList(),
                mode);
            planKey = (routeEventId, routeDate);
            pickupRequests = await FurniturePickupService.GetAllRequestsAsync();
        }
        finally
        {
            isPlanning = false;
        }
    }

    private static string FormatDuration(double seconds)
    {
        var t = TimeSpan.FromSeconds(seconds);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours} h {t.Minutes:00} min" : $"{t.Minutes} min";
    }

    // ── Beispieldaten ────────────────────────────────────────────────────────
    private async Task CreateSampleData()
    {
        isSampleBusy = true;
        try
        {
            var (eventId, pickupDate) = await SampleDataService.CreateRouteSampleAsync();
            await ReloadAfterSampleChangeAsync();

            // Gleich den Beispiel-Tag anzeigen
            routeEventId = eventId;
            routeDate    = pickupDate;
            planResult   = null;
            await LoadRouteSettingsAsync();
        }
        finally
        {
            isSampleBusy = false;
        }
    }

    private async Task RemoveSampleData()
    {
        isSampleBusy = true;
        try
        {
            await SampleDataService.RemoveRouteSampleAsync();
            routeEventId = 0;
            routeDate    = null;
            planResult   = null;
            await LoadRouteSettingsAsync();
            await ReloadAfterSampleChangeAsync();
        }
        finally
        {
            isSampleBusy = false;
        }
    }

    private async Task ReloadAfterSampleChangeAsync()
    {
        events         = await AreaService.GetAllEventsAsync();
        vehicles       = await VehicleService.GetAllVehiclesAsync();
        assignments    = await VehicleService.GetAssignmentsByEventAsync(0);
        pickupRequests = await FurniturePickupService.GetAllRequestsAsync();
        hasSampleData  = await SampleDataService.HasRouteSampleAsync();
    }

    private async Task ExportRoute()
    {
        if (!routeDate.HasValue) return;
        isExportingRoute = true;
        try
        {
            var bytes    = await ExportService.ExportRouteAsync(
                               routeEventId > 0 ? routeEventId : null,
                               routeDate.Value);
            var dateStr  = routeDate.Value.ToString("yyyyMMdd");
            var fileName = $"Route_{dateStr}.xlsx";
            var base64   = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);
        }
        finally
        {
            isExportingRoute = false;
        }
    }

    private async Task ReassignPickup(int requestId, string? vehicleIdStr)
    {
        int? vehicleId = int.TryParse(vehicleIdStr, out var v) && v > 0 ? v : (int?)null;
        await FurniturePickupService.AssignVehicleAsync(requestId, vehicleId);
        pickupRequests = await FurniturePickupService.GetAllRequestsAsync();
    }

    private RenderFragment RouteTable(List<FurniturePickupRequest> rows, bool showVehicleColumn) => __builder =>
    {
        var dayVehicles = VehiclesOnRouteDay;
        <table class="av-table">
            <thead>
                <tr>
                    <th style="width:2.5rem">#</th>
                    <th>Auftrag / Person / Adresse</th>
                    <th>Möbel</th>
                    <th>Status</th>
                    @if (showVehicleColumn) { <th style="width:160px">Fahrzeug</th> }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < rows.Count; i++)
                {
                    var req = rows[i];
                    var idx = i + 1;
                    <tr>
                        <td><span class="av-route-index">@idx</span></td>
                        <td>
                            <strong>#@req.OrderNumber</strong><br />
                            @req.FirstName @req.LastName
                            @if (!string.IsNullOrEmpty(req.PhoneNumber))
                            {
                                <span> · 📞 @req.PhoneNumber</span>
                            }
                            <br />
                            <a href="https://www.google.com/maps/search/@Uri.EscapeDataString($"{req.Street}, {req.PostalCode} {req.City}")"
                               target="_blank" rel="noopener noreferrer" class="av-addr-link">
                                @req.Street, @req.PostalCode @req.City
                            </a>
                            @if (req.GeocodedAddress != null && req.Latitude == null)
                            {
                                <br /><span class="av-badge av-badge--pending" title="Die Adresssuche hat nichts gefunden – nicht in der Optimierung">📍 Adresse nicht gefunden</span>
                            }
                        </td>
                        <td><small>@req.Description</small></td>
                        <td>
                            @if (req.Status == PickupRequestStatus.Pending)
                            {
                                <span class="av-badge av-badge--pending">⏳ Ausstehend</span>
                            }
                            else if (req.Status == PickupRequestStatus.Accepted)
                            {
                                <span class="av-badge av-badge--accepted">✅ Akzeptiert</span>
                            }
                        </td>
                        @if (showVehicleColumn)
                        {
                            var currentReq = req;
                            <td>
                                <select class="av-input av-input--sm"
                                        value="@(currentReq.AssignedVehicleId?.ToString() ?? "")"
                                        @onchange="e => ReassignPickup(currentReq.Id, e.Value?.ToString())">
                                    <option value="">– Nicht zugeteilt –</option>
                                    @foreach (var dv in dayVehicles)
                                    {
                                        <option value="@dv.Id">@dv.OwnerName</option>
                                    }
                                </select>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    };



    // ── Create Vehicle ────────────────────────────────────────────────────────
    private bool    showVehicleForm = false;
    private Vehicle newVehicle      = new();

    // ── Shared State ──────────────────────────────────────────────────────────
    private bool    isSaving      = false;
    private string? createSuccess = null;
    private string? createError   = null;

    // ── Edit Vehicle ──────────────────────────────────────────────────────────
    private Vehicle? editVehicle = null;

    // ── Init ──────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        events         = await AreaService.GetAllEventsAsync();
        users          = await VehicleService.GetAllUsersAsync();
        vehicles       = await VehicleService.GetAllVehiclesAsync();
        assignments    = await VehicleService.GetAssignmentsByEventAsync(0);
        pickupRequests = await FurniturePickupService.GetAllRequestsAsync();
        hasSampleData  = await SampleDataService.HasRouteSampleAsync();

        // Einsatzplan: nächstes Flomi, sonst das letzte
        var nextEvent = events.Where(e => !e.IsSample && e.Date.Date >= DateTime.Today).MinBy(e => e.Date)
                     ?? events.Where(e => !e.IsSample).MaxBy(e => e.Date);
        if (nextEvent != null)
            await SelectPlanEvent(nextEvent.Id);
    }

    // ── Sort: Fahrzeuge ───────────────────────────────────────────────────────
    private string vehicleSortColumn = "Name";
    private bool   vehicleSortAsc    = true;

    private IEnumerable<Vehicle> DisplayedVehicles
    {
        get
        {
            var result = (vehicles ?? new()).AsEnumerable();
            result = vehicleSortColumn switch
            {
                "Kontakt"      => vehicleSortAsc ? result.OrderBy(v => v.OwnerContact) : result.OrderByDescending(v => v.OwnerContact),
                "Zuweisungen"  => vehicleSortAsc ? result.OrderBy(v => v.Assignments.Select(a => a.EventId).Distinct().Count()) : result.OrderByDescending(v => v.Assignments.Select(a => a.EventId).Distinct().Count()),
                _              => vehicleSortAsc ? result.OrderBy(v => v.OwnerName)    : result.OrderByDescending(v => v.OwnerName),
            };
            return result;
        }
    }

    private void SortVehicleBy(string column)
    {
        if (vehicleSortColumn == column) vehicleSortAsc = !vehicleSortAsc;
        else { vehicleSortColumn = column; vehicleSortAsc = true; }
    }

    private string VehicleSortIcon(string col) =>
        vehicleSortColumn != col ? "⇅" : vehicleSortAsc ? "▲" : "▼";

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static List<DateTime> GetEventDays(Event ev) =>
        Enumerable.Range(-8, 9)          // 8 Tage vor Event bis Eventtag
                  .Select(i => ev.Date.Date.AddDays(i))
                  .ToList();

    // ── Tab ───────────────────────────────────────────────────────────────────
    private void SetTab(Tab tab)
    {
        activeTab       = tab;
        createSuccess   = null;
        createError     = null;
        showVehicleForm = false;
    }

    // ── Create Vehicle ────────────────────────────────────────────────────────
    private async Task CreateVehicle()
    {
        createSuccess = null;
        createError   = null;
        if (string.IsNullOrWhiteSpace(newVehicle.OwnerName))
        {
            createError = "Bitte einen Namen eingeben.";
            return;
        }

        isSaving = true;
        try
        {
            var name = newVehicle.OwnerName.Trim();
            newVehicle.OwnerName = name;
            await VehicleService.CreateVehicleAsync(newVehicle);
            createSuccess   = $"Fahrzeug «{name}» wurde erfolgreich erfasst.";
            vehicles        = await VehicleService.GetAllVehiclesAsync();
            newVehicle      = new Vehicle();
            showVehicleForm = false;

            if (showNewVehicleModal)
            {
                showNewVehicleModal = false;
                planMessageIsError  = false;
                planMessage         = $"🚗 «{name}» erfasst. Klicke in seiner Zeile auf ＋, um Einsatztage einzutragen.";
            }
        }
        catch (Exception ex)
        {
            createError = $"Fehler beim Speichern: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetVehicleForm()
    {
        newVehicle      = new Vehicle();
        createSuccess   = null;
        createError     = null;
        showVehicleForm = false;
    }

    // ── Edit Vehicle ──────────────────────────────────────────────────────────
    private void OpenEditVehicle(Vehicle v)
    {
        createError = null;
        editVehicle = new Vehicle
        {
            Id           = v.Id,
            OwnerName    = v.OwnerName,
            OwnerPhone   = v.OwnerPhone,
            OwnerContact = v.OwnerContact
        };
    }

    private void CloseEditVehicle()
    {
        editVehicle = null;
        createError = null;
    }

    private async Task SaveEditVehicle()
    {
        if (editVehicle == null) return;

        isSaving = true;
        try
        {
            await VehicleService.UpdateVehicleAsync(editVehicle);
            vehicles = await VehicleService.GetAllVehiclesAsync();
            CloseEditVehicle();
        }
        catch (Exception ex)
        {
            createError = $"Fehler beim Speichern: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteVehicle(int id)
    {
        await VehicleService.DeleteVehicleAsync(id);
        await ReloadPlanAsync();
    }

    private string? GetDriverDisplay(AssignmentDate d)
    {
        if (!string.IsNullOrEmpty(d.DriverName))
            return d.DriverName;
        if (!string.IsNullOrEmpty(d.DriverUserId))
        {
            var u = users?.FirstOrDefault(u => u.Id == d.DriverUserId);
            return u != null ? $"{u.FirstName} {u.LastName}" : null;
        }
        return null;
    }

    private string? GetHelperDisplay(AssignmentDate d)
    {
        if (!string.IsNullOrEmpty(d.HelperName))
            return d.HelperName;
        if (!string.IsNullOrEmpty(d.HelperUserId))
        {
            var u = users?.FirstOrDefault(u => u.Id == d.HelperUserId);
            return u != null ? $"{u.FirstName} {u.LastName}" : null;
        }
        return null;
    }

    // ── Einsatzplan (Fahrzeuge × Tage) ────────────────────────────────────────
    private int                                         planEventId        = 0;
    private Event?                                      planEvent          = null;
    private List<DateTime>                              planDays           = new();
    private Dictionary<DateTime, List<ApplicationUser>> planDrivers        = new();
    private Dictionary<DateTime, List<ApplicationUser>> planHelpers        = new();
    private List<VehicleDayCoverage>                    planCoverage       = new();
    private bool                                        isPlanBusy         = false;
    private string?                                     planMessage        = null;
    private bool                                        planMessageIsError = false;
    private int                                         copySourceEventId  = 0;

    private IEnumerable<Event> PlanEvents => (events ?? new()).OrderByDescending(e => e.Date);

    private List<VehicleAssignment> PlanAssignments =>
        (assignments ?? new()).Where(a => a.EventId == planEventId).ToList();

    private bool PlanHasAssignments => PlanAssignments.Any(a => a.AssignedDates.Any());

    // Beispiel-Fahrzeuge nur dort, wo sie eingeteilt sind (Beispiel-Event)
    private List<Vehicle> PlanVehicles =>
        (vehicles ?? new())
        .Where(v => !v.IsSample || PlanAssignments.Any(a => a.VehicleId == v.Id))
        .OrderBy(v => v.OwnerName, StringComparer.CurrentCultureIgnoreCase)
        .ToList();

    private IEnumerable<Event> CopySourceEvents =>
        PlanEvents.Where(e => e.Id != planEventId && !e.IsSample
                           && (assignments ?? new()).Any(a => a.EventId == e.Id && a.AssignedDates.Any()));

    private AssignmentDate? SlotFor(int vehicleId, DateTime day) =>
        PlanAssignments.Where(a => a.VehicleId == vehicleId)
                       .SelectMany(a => a.AssignedDates)
                       .FirstOrDefault(d => d.Date.Date == day);

    private List<AssignmentDate> SlotsOn(DateTime day) =>
        PlanAssignments.SelectMany(a => a.AssignedDates).Where(d => d.Date.Date == day).ToList();

    private VehicleDayCoverage CoverageFor(DateTime day) =>
        planCoverage.FirstOrDefault(c => c.Date == day) ?? new VehicleDayCoverage(planEventId, day, 0, 0, 0);

    private string DayStatusClass(DateTime day)
    {
        var c = CoverageFor(day);
        if (c.PickupsWithoutCrew)        return "av-plan__day--alert";
        if (c.VehiclesWithoutDriver > 0) return "av-plan__day--warn";
        if (c.Vehicles > 0)              return "av-plan__day--ok";
        return "";
    }

    private string? DayStatusTitle(DateTime day)
    {
        var c = CoverageFor(day);
        if (c.PickupsWithoutCrew)        return $"{c.Pickups} Abholungen, aber kein Fahrzeug mit Fahrer";
        if (c.VehiclesWithoutDriver > 0) return $"{c.VehiclesWithoutDriver} von {c.Vehicles} Fahrzeugen ohne Fahrer";
        if (c.Vehicles > 0)              return $"{c.Vehicles} Fahrzeug(e) mit Fahrer";
        return null;
    }

    private HashSet<string> BusyUserIds(DateTime day) =>
        SlotsOn(day).SelectMany(d => new[] { d.DriverUserId, d.HelperUserId })
                    .Where(id => id != null).Select(id => id!)
                    .ToHashSet();

    private static List<ApplicationUser> RegisteredOn(Dictionary<DateTime, List<ApplicationUser>> byDate, DateTime day) =>
        byDate.TryGetValue(day, out var list) ? list : new();

    // Für Fahrer/Beifahrer angemeldet, aber noch auf keinem Fahrzeug
    private List<(ApplicationUser User, string Role)> OpenCrew(DateTime day)
    {
        var busy    = BusyUserIds(day);
        var drivers = RegisteredOn(planDrivers, day).Where(u => !busy.Contains(u.Id)).ToList();
        var helpers = RegisteredOn(planHelpers, day).Where(u => !busy.Contains(u.Id)).ToList();
        return drivers.Select(u => (u, helpers.Any(h => h.Id == u.Id) ? "Fahrer/Beifahrer" : "Fahrer"))
            .Concat(helpers.Where(h => drivers.All(d => d.Id != h.Id)).Select(u => (u, "Beifahrer")))
            .ToList();
    }

    private bool CanAutoAssign(DateTime day)
    {
        var slots = SlotsOn(day);
        var busy  = BusyUserIds(day);
        return (slots.Any(s => !s.HasDriver) && RegisteredOn(planDrivers, day).Any(u => !busy.Contains(u.Id)))
            || (slots.Any(s => !s.HasHelper) && RegisteredOn(planHelpers, day).Concat(RegisteredOn(planDrivers, day))
                                                     .Any(u => !busy.Contains(u.Id)));
    }

    private async Task OnPlanEventChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            await SelectPlanEvent(id);
    }

    private async Task SelectPlanEvent(int eventId)
    {
        planEventId = eventId;
        planEvent   = events?.FirstOrDefault(e => e.Id == eventId);
        planDays    = planEvent != null ? GetEventDays(planEvent) : new();
        planMessage = null;

        if (planEvent != null)
        {
            planDrivers = await VehicleService.GetUsersByAreaNameAndEventAsync(eventId, VehicleCrewAreas.Driver);
            planHelpers = await VehicleService.GetUsersByAreaNameAndEventAsync(eventId, VehicleCrewAreas.Helper);
        }
        else
        {
            planDrivers = new();
            planHelpers = new();
        }

        await ReloadPlanAsync();
        copySourceEventId = CopySourceEvents.FirstOrDefault()?.Id ?? 0;
    }

    private async Task ReloadPlanAsync()
    {
        vehicles     = await VehicleService.GetAllVehiclesAsync();
        assignments  = await VehicleService.GetAssignmentsByEventAsync(0);
        planCoverage = planEventId > 0
            ? await VehicleService.GetDayCoverageAsync(new[] { planEventId })
            : new();
    }

    // Erklärt, warum die automatische Einteilung nichts tun konnte
    private string NobodyAssignedReason(DateTime? day)
    {
        var days      = day.HasValue ? new List<DateTime> { day.Value } : planDays;
        var slots     = days.SelectMany(SlotsOn).ToList();
        var crewDays  = days.Where(d => OpenCrew(d).Any()).ToList();
        var noVehicle = crewDays.Where(d => !SlotsOn(d).Any()).Select(d => d.ToString("ddd dd.MM")).ToList();

        if (!slots.Any())
            return "Noch keine Fahrzeuge eingetragen. Klicke zuerst bei jedem Fahrzeug an den Tagen auf ＋, an denen es " +
                   "zur Verfügung steht – danach verteilt dieser Knopf die angemeldeten Fahrer darauf." +
                   (noVehicle.Any() ? $" Angemeldet sind Fahrer/Beifahrer an: {string.Join(", ", noVehicle)}." : "");
        if (slots.All(s => s.HasDriver && s.HasHelper))
            return "Alle eingetragenen Fahrzeuge haben schon Fahrer und Helfer.";
        if (noVehicle.Any())
            return $"An den Tagen mit freien Plätzen ist niemand mehr frei angemeldet. Freie Fahrer/Beifahrer gibt es an " +
                   $"{string.Join(", ", noVehicle)} – dort ist aber noch kein Fahrzeug eingetragen.";
        return "Niemand eingeteilt: An den Tagen mit freien Plätzen hat sich niemand als «Fahrer» oder «Beifahrer» angemeldet.";
    }

    private async Task AutoAssignCrew(DateTime? day)
    {
        if (planEventId == 0) return;
        isPlanBusy = true;
        try
        {
            var result = await VehicleService.AutoAssignCrewAsync(planEventId, day);
            await ReloadPlanAsync();
            planMessageIsError = false;
            planMessage = result.DriversAssigned + result.HelpersAssigned == 0
                ? NobodyAssignedReason(day)
                : $"🤖 {result.DriversAssigned} Fahrer und {result.HelpersAssigned} Beifahrer eingeteilt" +
                  (day.HasValue ? $" ({day.Value:ddd dd.MM})" : "") +
                  ". Jedes Feld lässt sich danach von Hand anpassen.";
        }
        catch (Exception ex)
        {
            planMessageIsError = true;
            planMessage        = $"Fehler beim Einteilen: {ex.Message}";
        }
        finally
        {
            isPlanBusy = false;
        }
    }

    private async Task CopyFromEvent()
    {
        if (copySourceEventId == 0 || planEventId == 0) return;
        isPlanBusy = true;
        try
        {
            var count  = await VehicleService.CopyAssignmentsFromEventAsync(copySourceEventId, planEventId);
            var source = events?.FirstOrDefault(e => e.Id == copySourceEventId);
            await ReloadPlanAsync();
            planMessageIsError = count == 0;
            planMessage = count == 0
                ? "Nichts übernommen: Im gewählten Event sind keine Fahrzeuge eingeteilt."
                : $"🔁 {count} Fahrzeug(e) mit ihren Einsatztagen aus «{source?.Name}» übernommen. Jetzt noch die Fahrer einteilen.";
        }
        finally
        {
            isPlanBusy = false;
        }
    }

    // ── Einsatztag bearbeiten ─────────────────────────────────────────────────
    private Vehicle?       cellVehicle       = null;
    private DateTime       cellDate;
    private AssignmentDate cellEdit          = new();
    private bool           cellExists        = false;
    private string         cellDriverText    = "";
    private string         cellHelperText    = "";
    private bool           cellShowMore      = false;
    private bool           cellConfirmRemove = false;
    private string?        cellError         = null;

    private void OpenCell(Vehicle v, DateTime day)
    {
        var slot = SlotFor(v.Id, day);
        cellVehicle       = v;
        cellDate          = day;
        cellExists        = slot != null;
        cellError         = null;
        cellConfirmRemove = false;
        cellEdit = new AssignmentDate
        {
            Date         = day,
            DriverUserId = slot?.DriverUserId,
            DriverName   = slot?.DriverName,
            DriverPhone  = slot?.DriverPhone,
            HelperUserId = slot?.HelperUserId,
            HelperName   = slot?.HelperName,
            ReadyFrom    = slot?.ReadyFrom,
            PickedUpBy   = slot?.PickedUpBy,
            ReturnedBy   = slot?.ReturnedBy,
        };
        cellDriverText = GetDriverDisplay(cellEdit) ?? "";
        cellHelperText = GetHelperDisplay(cellEdit) ?? "";
        cellShowMore   = !string.IsNullOrEmpty(cellEdit.ReadyFrom)
                      || !string.IsNullOrEmpty(cellEdit.PickedUpBy)
                      || !string.IsNullOrEmpty(cellEdit.ReturnedBy);
    }

    private void CloseCell()
    {
        cellVehicle = null;
        cellError   = null;
    }

    private static string FullName(ApplicationUser u) => $"{u.FirstName} {u.LastName}".Trim();

    // Angemeldete zuerst, danach alle übrigen Konten
    private IEnumerable<(ApplicationUser User, string Label)> CrewSuggestions(Dictionary<DateTime, List<ApplicationUser>> registered)
    {
        var onDay = RegisteredOn(registered, cellDate);
        return onDay.Select(u => (u, "✅ für diesen Tag angemeldet"))
            .Concat((users ?? new()).Where(u => onDay.All(r => r.Id != u.Id)).Select(u => (u, "")));
    }

    private ApplicationUser? FindUser(string name, Dictionary<DateTime, List<ApplicationUser>> registered)
    {
        bool Matches(ApplicationUser u) => string.Equals(FullName(u), name, StringComparison.CurrentCultureIgnoreCase);
        return RegisteredOn(registered, cellDate).FirstOrDefault(Matches) ?? users?.FirstOrDefault(Matches);
    }

    // Ein Feld für Konto und freien Namen: passt der Name zu einem Konto, wird es verknüpft
    private void OnCellDriverChanged(string? text)
    {
        cellDriverText = text?.Trim() ?? "";
        var user = cellDriverText.Length == 0 ? null : FindUser(cellDriverText, planDrivers);
        cellEdit.DriverUserId = user?.Id;
        cellEdit.DriverName   = user == null && cellDriverText.Length > 0 ? cellDriverText : null;

        if (user != null && !string.IsNullOrEmpty(user.PhoneNumber))
            cellEdit.DriverPhone = PhoneHelper.FormatSwissPhone(user.PhoneNumber);
        else if (cellDriverText.Length == 0)
            cellEdit.DriverPhone = null;
    }

    private void OnCellHelperChanged(string? text)
    {
        cellHelperText = text?.Trim() ?? "";
        var user = cellHelperText.Length == 0 ? null : FindUser(cellHelperText, planHelpers);
        cellEdit.HelperUserId = user?.Id;
        cellEdit.HelperName   = user == null && cellHelperText.Length > 0 ? cellHelperText : null;
    }

    // Fahrzeug, auf dem die Person an diesem Tag schon eingeteilt ist
    private string? ConflictFor(string? userId)
    {
        if (string.IsNullOrEmpty(userId) || cellVehicle == null) return null;
        return PlanAssignments
            .Where(a => a.VehicleId != cellVehicle.Id)
            .FirstOrDefault(a => a.AssignedDates.Any(d => d.Date.Date == cellDate
                                                       && (d.DriverUserId == userId || d.HelperUserId == userId)))
            ?.Vehicle?.OwnerName;
    }

    private (string Text, string Css) CrewHint(string? userId, string? freeName,
        Dictionary<DateTime, List<ApplicationUser>> registered, string role)
    {
        if (!string.IsNullOrEmpty(userId))
        {
            if (ConflictFor(userId) is { } other)
                return ($"⚠️ An diesem Tag schon bei «{other}» eingeteilt", "av-hint--error");
            return RegisteredOn(registered, cellDate).Any(u => u.Id == userId)
                ? ($"✅ Konto, für «{role}» angemeldet", "av-hint--ok")
                : ("👤 Konto, aber nicht für diesen Tag angemeldet", "av-hint--info");
        }
        return string.IsNullOrWhiteSpace(freeName) ? ("", "") : ("✏️ Freier Name ohne Konto", "av-hint--info");
    }

    private async Task SaveCell()
    {
        if (cellVehicle == null) return;

        if (!string.IsNullOrEmpty(cellEdit.DriverUserId) && cellEdit.DriverUserId == cellEdit.HelperUserId)
        {
            cellError = "Fahrer und Helfer sind dieselbe Person.";
            return;
        }
        if ((ConflictFor(cellEdit.DriverUserId) ?? ConflictFor(cellEdit.HelperUserId)) is { } other)
        {
            cellError = $"Diese Person ist an diesem Tag schon bei «{other}» eingeteilt.";
            return;
        }

        isSaving = true;
        try
        {
            await VehicleService.SaveAssignmentDayAsync(cellVehicle.Id, planEventId, cellEdit);
            await ReloadPlanAsync();
            CloseCell();
        }
        catch (Exception ex)
        {
            cellError = $"Fehler beim Speichern: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RemoveCell()
    {
        if (cellVehicle == null) return;
        if (!cellConfirmRemove)
        {
            cellConfirmRemove = true;
            return;
        }

        isSaving = true;
        try
        {
            await VehicleService.RemoveAssignmentDayAsync(cellVehicle.Id, planEventId, cellDate);
            await ReloadPlanAsync();
            CloseCell();
        }
        catch (Exception ex)
        {
            cellError = $"Fehler beim Entfernen: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    // ── Neues Fahrzeug aus dem Einsatzplan ────────────────────────────────────
    private bool showNewVehicleModal = false;

    private void OpenNewVehicleModal()
    {
        newVehicle          = new Vehicle();
        createError         = null;
        showNewVehicleModal = true;
    }

    private RenderFragment VehicleFields(Vehicle v) => __builder =>
    {
        <div class="av-form-grid">
            <div class="av-field">
                <label>Name *</label>
                <InputText @bind-Value="v.OwnerName" class="av-input" placeholder="z.B. Max Mustermann" />
            </div>
            <div class="av-field">
                <label>Telefon</label>
                <input type="text"
                       class="av-input"
                       placeholder="+41 79 000 00 00"
                       value="@v.OwnerPhone"
                       @onchange="e => v.OwnerPhone = PhoneHelper.FormatSwissPhone(e.Value?.ToString())" />
            </div>
            <div class="av-field">
                <label>Kontakt / Bemerkung</label>
                <InputText @bind-Value="v.OwnerContact" class="av-input" placeholder="z.B. Transporter, 8 Plätze" />
            </div>
        </div>
    };
