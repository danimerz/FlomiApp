@page "/admin/vehicles"
@using FlomiApp.Data.Models
@using FlomiApp.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@inject IAreaService            AreaService
@inject IVehicleService         VehicleService
@inject IFurniturePickupService FurniturePickupService
@inject IExportService          ExportService
@inject IRoutePlanningService   RoutePlanningService
@inject ISampleDataService      SampleDataService
@inject IJSRuntime              JS
@using FlomiApp.Security
@attribute [Authorize(Roles = Roles.AdminOrFahrzeug)]
@attribute [Authorize(Policy = Roles.RequireTwoFactorForAdmins)]

<PageTitle>Fahrzeuge – Admin</PageTitle>

<div class="dashboard-page">

    <!-- ── Hero ──────────────────────────────────────────────────────────── -->
    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <span class="dashboard-hero__badge">Administration</span>
            <h1>Fahrzeuge</h1>
            <p>Plane pro Event, welches Fahrzeug an welchem Tag mit wem unterwegs ist.</p>
        </div>
    </section>

    <!-- ── Tabs ──────────────────────────────────────────────────────────── -->
    <div class="av-tabs">
        <button class="av-tab @(activeTab == Tab.Plan ? "av-tab--active" : "")"
                @onclick="() => SetTab(Tab.Plan)">
            📅 Einsatzplan
            @if (planCoverage.Any(c => c.NeedsAttention))
            {
                <span class="av-tab__badge" title="Tage mit fehlendem Fahrer">⚠️ @planCoverage.Count(c => c.NeedsAttention)</span>
            }
        </button>
        <button class="av-tab @(activeTab == Tab.Vehicles ? "av-tab--active" : "")"
                @onclick="() => SetTab(Tab.Vehicles)">
            🚗 Fahrzeuge
            @if (vehicles != null)
            {
                <span class="av-tab__badge">@vehicles.Count</span>
            }
        </button>
        <button class="av-tab @(activeTab == Tab.Route ? "av-tab--active" : "")"
                @onclick="() => SetTab(Tab.Route)">
            🗺️ Routenplanung
            @if (pickupRequests != null)
            {
                var cnt = pickupRequests.Count(r =>
                    r.Status == PickupRequestStatus.Accepted);
                if (cnt > 0) { <span class="av-tab__badge">@cnt</span> }
            }
        </button>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════
         TAB: FAHRZEUGE (Stammdaten)
    ════════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == Tab.Vehicles)
    {
        <div class="av-toolbar">
            <button class="av-submit-btn" @onclick="() => { showVehicleForm = !showVehicleForm; createSuccess = null; createError = null; }">
                ＋ Neues Fahrzeug
            </button>
        </div>

        @if (showVehicleForm)
        {
            <div class="av-form-card">
                <div class="av-form-card__header">
                    <h3>🚗 Neues Fahrzeug erfassen</h3>
                </div>
                <div class="av-form-card__body">
                    <EditForm Model="newVehicle" OnValidSubmit="CreateVehicle">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="av-validation" />

                        @VehicleFields(newVehicle)

                        @if (createSuccess != null)
                        {
                            <div class="av-state-card av-state-card--success" style="margin-top:1rem">
                                <div class="av-state-card__icon">✅</div>
                                <div class="av-state-card__content"><p>@createSuccess</p></div>
                            </div>
                        }
                        @if (createError != null)
                        {
                            <div class="av-state-card av-state-card--error" style="margin-top:1rem">
                                <div class="av-state-card__icon">⚠️</div>
                                <div class="av-state-card__content"><p>@createError</p></div>
                            </div>
                        }

                        <div class="av-form-actions">
                            <button type="submit" class="av-submit-btn" disabled="@isSaving">
                                @if (isSaving) { <span>⏳ Wird gespeichert...</span> }
                                else           { <span>✅ Fahrzeug erfassen</span> }
                            </button>
                            <button type="button" class="av-cancel-btn" @onclick="ResetVehicleForm">
                                Abbrechen
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        }

        @if (vehicles == null)
        {
            <div class="av-state-card av-state-card--info">
                <div class="av-state-card__icon">⏳</div>
                <div class="av-state-card__content">
                    <h3>Fahrzeuge werden geladen...</h3>
                </div>
            </div>
        }
        else if (!vehicles.Any())
        {
            <div class="av-state-card av-state-card--empty">
                <div class="av-state-card__icon">🚗</div>
                <div class="av-state-card__content">
                    <h3>Keine Fahrzeuge vorhanden</h3>
                    <p>Erfasse ein neues Fahrzeug mit dem Button oben.</p>
                </div>
            </div>
        }
        else
        {
            <table class="av-table">
                <thead>
                    <tr>
                        <th class="av-th-sort" @onclick='() => SortVehicleBy("Name")'>
                            Fahrzeughalter <span class="av-sort-icon">@VehicleSortIcon("Name")</span>
                        </th>
                        <th>Telefon</th>
                        <th class="av-th-sort" @onclick='() => SortVehicleBy("Kontakt")'>
                            Kontakt / Bemerkung <span class="av-sort-icon">@VehicleSortIcon("Kontakt")</span>
                        </th>
                        <th class="av-th-sort" @onclick='() => SortVehicleBy("Zuweisungen")'>
                            Zuweisungen <span class="av-sort-icon">@VehicleSortIcon("Zuweisungen")</span>
                        </th>
                        <th>Aktionen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in DisplayedVehicles)
                    {
                        <tr>
                            <td><strong>@v.OwnerName</strong></td>
                            <td>
                                @if (!string.IsNullOrEmpty(v.OwnerPhone))
                                {
                                    <span>📞 @v.OwnerPhone</span>
                                }
                                else
                                {
                                    <span class="av-badge av-badge--none">–</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(v.OwnerContact))
                                {
                                    <small>@v.OwnerContact</small>
                                }
                                else
                                {
                                    <span class="av-badge av-badge--none">–</span>
                                }
                            </td>
                            <td>
                                <span class="av-badge av-badge--driver">
                                    @v.Assignments.Select(a => a.EventId).Distinct().Count() Events
                                </span>
                            </td>
                            <td>
                                <div class="av-actions">
                                    <button class="av-btn av-btn--edit"
                                            @onclick="() => OpenEditVehicle(v)">
                                        ✏️ Edit
                                    </button>
                                    <button class="av-btn av-btn--delete"
                                            @onclick="() => DeleteVehicle(v.Id)">
                                        🗑️ Löschen
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    <!-- ════════════════════════════════════════════════════════════════════
         TAB: EINSATZPLAN (Fahrzeuge × Tage)
    ════════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == Tab.Plan)
    {
        <div class="av-toolbar">
            <div class="av-field" style="min-width:280px">
                <label>Event</label>
                <select class="av-input" value="@planEventId" @onchange="OnPlanEventChanged">
                    <option value="0" disabled>– Bitte wählen –</option>
                    @foreach (var ev in PlanEvents)
                    {
                        <option value="@ev.Id">@ev.Name (@ev.Date.ToString("dd.MM.yyyy"))@(ev.IsSample ? " – Beispiel" : "")</option>
                    }
                </select>
            </div>
            @if (planEvent != null)
            {
                <button class="av-auto-btn" @onclick="() => AutoAssignCrew(null)" disabled="@isPlanBusy"
                        title="Verteilt die angemeldeten Fahrer und Beifahrer auf Fahrzeuge ohne Besatzung. Bestehende Einteilungen bleiben.">
                    @(isPlanBusy ? "⏳ Moment..." : "🤖 Fahrer automatisch einteilen")
                </button>
                <button class="av-auto-btn av-auto-btn--secondary" @onclick="OpenNewVehicleModal">
                    ＋ Neues Fahrzeug
                </button>
            }
        </div>

        @if (planMessage != null)
        {
            <div class="av-plan-result @(planMessageIsError ? "av-plan-result--error" : "")" role="status">
                <span>@planMessage</span>
            </div>
        }

        @if (planEvent == null)
        {
            <div class="av-state-card av-state-card--info">
                <div class="av-state-card__icon">🎪</div>
                <div class="av-state-card__content">
                    <h3>Bitte ein Event wählen</h3>
                    <p>Der Einsatzplan zeigt pro Event, welches Fahrzeug an welchem Tag mit wem unterwegs ist.</p>
                </div>
            </div>
        }
        else
        {
            @if (!PlanHasAssignments && CopySourceEvents.Any())
            {
                <div class="av-copy-card">
                    <div class="av-copy-card__text">
                        <strong>🔁 Noch keine Fahrzeuge eingeteilt.</strong>
                        <span>Übernimm die Fahrzeuge mit denselben Tagen (relativ zum Flomi) – ohne Fahrer und Helfer.</span>
                    </div>
                    <div class="av-copy-card__actions">
                        <select class="av-input av-input--sm" @bind="copySourceEventId" aria-label="Vorlage-Event">
                            @foreach (var ev in CopySourceEvents)
                            {
                                <option value="@ev.Id">@ev.Name (@ev.Date.ToString("dd.MM.yyyy"))</option>
                            }
                        </select>
                        <button class="av-btn av-btn--edit" @onclick="CopyFromEvent" disabled="@isPlanBusy">
                            🔁 Fahrzeuge übernehmen
                        </button>
                    </div>
                </div>
            }

            @if (!PlanVehicles.Any())
            {
                <div class="av-state-card av-state-card--empty">
                    <div class="av-state-card__icon">🚗</div>
                    <div class="av-state-card__content">
                        <h3>Noch keine Fahrzeuge erfasst</h3>
                        <p>Erfasse ein Fahrzeug mit «＋ Neues Fahrzeug». Es erscheint danach als Zeile im Plan.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="av-plan-wrap">
                    <table class="av-plan">
                        <thead>
                            <tr>
                                <th class="av-plan__corner" scope="col">Fahrzeug</th>
                                @foreach (var day in planDays)
                                {
                                    var cov = CoverageFor(day);
                                    <th class="av-plan__day @DayStatusClass(day)" scope="col" title="@DayStatusTitle(day)">
                                        <span class="av-plan__dow">@day.ToString("ddd")</span>
                                        <span class="av-plan__date">@day.ToString("dd.MM")</span>
                                        @if (day == planEvent.Date.Date)
                                        {
                                            <span class="av-plan__flag">🎪 Flomi</span>
                                        }
                                        @if (cov.Pickups > 0)
                                        {
                                            <span class="av-plan__pickups">📦 @cov.Pickups</span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in PlanVehicles)
                            {
                                var veh = v;
                                <tr>
                                    <th class="av-plan__vehicle" scope="row">
                                        <strong>@veh.OwnerName</strong>
                                        @if (!string.IsNullOrEmpty(veh.OwnerPhone))
                                        {
                                            <small>📞 @veh.OwnerPhone</small>
                                        }
                                        @if (!string.IsNullOrEmpty(veh.OwnerContact))
                                        {
                                            <small>@veh.OwnerContact</small>
                                        }
                                    </th>
                                    @foreach (var day in planDays)
                                    {
                                        var d    = day;
                                        var slot = SlotFor(veh.Id, d);
                                        <td class="av-plan__cell">
                                            @if (slot == null)
                                            {
                                                <button class="av-plan__add" @onclick="() => OpenCell(veh, d)"
                                                        title="@veh.OwnerName am @d.ToString("ddd dd.MM") einteilen"
                                                        aria-label="@veh.OwnerName am @d.ToString("dddd dd.MM") einteilen">＋</button>
                                            }
                                            else
                                            {
                                                <button class="av-plan__slot @(slot.HasDriver ? "" : "av-plan__slot--warn")"
                                                        @onclick="() => OpenCell(veh, d)">
                                                    <span class="av-plan__crew">🧑‍✈️ @(GetDriverDisplay(slot) ?? "Fahrer fehlt")</span>
                                                    <span class="av-plan__crew av-plan__crew--helper">🙋 @(GetHelperDisplay(slot) ?? "–")</span>
                                                    @if (!string.IsNullOrEmpty(slot.ReadyFrom))
                                                    {
                                                        <span class="av-plan__meta">ab @slot.ReadyFrom</span>
                                                    }
                                                </button>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th class="av-plan__vehicle" scope="row"><small>Pro Tag</small></th>
                                @foreach (var day in planDays)
                                {
                                    var d = day;
                                    <td class="av-plan__cell">
                                        @if (CanAutoAssign(d))
                                        {
                                            <button class="av-plan__auto" @onclick="() => AutoAssignCrew(d)" disabled="@isPlanBusy"
                                                    title="Angemeldete Fahrer und Beifahrer für @d.ToString("ddd dd.MM") einteilen">
                                                🤖 Einteilen
                                            </button>
                                        }
                                    </td>
                                }
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <p class="av-plan-legend">
                    Klick auf ein Feld zum Einteilen oder Ändern ·
                    <span class="av-plan-legend__item av-plan-legend__item--alert">Abholungen, aber kein Fahrer</span>
                    <span class="av-plan-legend__item av-plan-legend__item--warn">Fahrzeug ohne Fahrer</span>
                    <span class="av-plan-legend__item av-plan-legend__item--ok">alles besetzt</span>
                </p>

                var openDays = planDays.Select(d => (Day: d, Crew: OpenCrew(d))).Where(x => x.Crew.Any()).ToList();
                @if (openDays.Any())
                {
                    <div class="av-plan-open">
                        <h3>🙋 Angemeldet, aber noch nicht eingeteilt</h3>
                        <ul>
                            @foreach (var (day, crew) in openDays)
                            {
                                <li>
                                    <strong>@day.ToString("ddd dd.MM")</strong>
                                    @string.Join(", ", crew.Select(c => $"{FullName(c.User)} ({c.Role})"))
                                    @if (!SlotsOn(day).Any())
                                    {
                                        <span class="av-plan-open__hint">– an diesem Tag ist noch kein Fahrzeug eingetragen</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
    }



    <!-- ════════════════════════════════════════════════════════════════════
         TAB: ROUTENPLANUNG
    ════════════════════════════════════════════════════════════════════════ -->
    @if (activeTab == Tab.Route)
    {
        <!-- Filter Bar -->
        <div class="av-toolbar">
            <div class="av-field" style="min-width:280px">
                <label>Event auswählen</label>
                <select class="av-input" value="@routeEventId" @onchange="OnRouteEventChanged">
                    <option value="0">– Alle Events –</option>
                    @foreach (var ev in events ?? new())
                    {
                        <option value="@ev.Id">@ev.Name (@ev.Date.ToShortDateString())</option>
                    }
                </select>
            </div>

            @if (RouteAvailableDates.Any())
            {
                <div class="av-field">
                    <label>Abholdatum</label>
                    <div class="av-day-filter">
                        <button class="av-day-filter-btn @(routeDate == null ? "av-day-filter-btn--active" : "")"
                                @onclick="() => routeDate = null">Alle</button>
                        @foreach (var d in RouteAvailableDates)
                        {
                            var rdate = d;
                            <button class="av-day-filter-btn @(routeDate == rdate ? "av-day-filter-btn--active" : "")"
                                    @onclick="() => routeDate = rdate">
                                @rdate.ToString("ddd dd.MM", new CultureInfo("de-CH"))
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Beispieldaten zum Ausprobieren der Routenplanung -->
            <div class="av-sample-actions">
                @if (hasSampleData)
                {
                    <button class="av-sample-btn av-sample-btn--remove" @onclick="RemoveSampleData" disabled="@isSampleBusy">
                        @(isSampleBusy ? "⏳ Entferne..." : "🗑️ Beispieldaten entfernen")
                    </button>
                }
                <button class="av-sample-btn" @onclick="CreateSampleData" disabled="@isSampleBusy"
                        title="Legt einen versteckten Beispiel-Event mit 3 Fahrzeugen und 19 Abholungen an">
                    @(isSampleBusy ? "⏳ Lade..." : hasSampleData ? "🧪 Beispieldaten neu laden" : "🧪 Beispieldaten laden")
                </button>
            </div>
        </div>

        <!-- Startadresse + Planung (nur wenn Datum gewählt) -->
        @if (routeDate.HasValue && RoutePickups.Any())
        {
            <div class="av-route-controls">
                <div class="av-field" style="flex:1;max-width:420px">
                    <label>🚩 Startadresse</label>
                    <input type="text" class="av-input"
                           placeholder="z.B. Pfadistrasse 1, 6300 Zug"
                           @bind="routeStartAddress" />
                    @if (!string.IsNullOrEmpty(routeSettings?.DepartureAddress))
                    {
                        <small style="color:var(--color-text-light)">
                            Standard: @routeSettings.DepartureAddress
                        </small>
                    }
                </div>
                @if (VehiclesOnRouteDay.Any())
                {
                    <button class="av-auto-btn" @onclick="() => PlanRoutes(RoutePlanMode.Distribute)" disabled="@isPlanning"
                            title="Verteilt alle Abholungen neu auf die Fahrzeuge und legt die Reihenfolge fest">
                        @if (isPlanning) { <span>⏳ Plane...</span> }
                        else { <span>🧭 Optimal verteilen</span> }
                    </button>
                    @if (RoutePickups.Any(r => r.AssignedVehicleId.HasValue))
                    {
                        <button class="av-auto-btn av-auto-btn--secondary" @onclick="() => PlanRoutes(RoutePlanMode.OrderOnly)" disabled="@isPlanning"
                                title="Behält die Zuteilung bei und optimiert nur die Reihenfolge pro Fahrzeug">
                            <span>↕️ Nur Reihenfolge</span>
                        </button>
                    }
                }
                <button class="av-auto-btn" style="background:linear-gradient(135deg,#15803d,#22c55e);box-shadow:0 4px 12px rgba(21,128,61,.3)"
                        @onclick="ExportRoute" disabled="@isExportingRoute">
                    @if (isExportingRoute) { <span>⏳ Exportiere...</span> }
                    else { <span>📥 Excel exportieren</span> }
                </button>
            </div>

            @if (CurrentPlan is { } plan)
            {
                <div class="av-plan-result @(plan.Success ? "" : "av-plan-result--error")">
                    @if (!plan.Success)
                    {
                        <span>⚠️ @plan.Error</span>
                    }
                    else
                    {
                        <div>
                            ✅ <strong>Plan gespeichert:</strong>
                            @plan.Vehicles.Sum(v => v.Stops) Stopps auf @plan.Vehicles.Count(v => v.Stops > 0) Fahrzeuge,
                            längste Tour ≈ @FormatDuration(plan.Vehicles.Max(v => v.Seconds)).
                        </div>
                        <small>
                            @(plan.IsEstimate
                                ? "Fahrzeiten nach Luftlinie geschätzt (kein OpenRouteService-Schlüssel hinterlegt)."
                                : "Fahrzeiten aus dem Strassennetz (OpenRouteService).")
                            Inkl. @((int)(RouteOptimizer.ServiceSecondsPerStop / 60)) Min. Ladezeit pro Stopp und Rückfahrt zur Startadresse.
                        </small>
                        @if (plan.UnlocatedOrderNumbers.Any())
                        {
                            <div class="av-plan-result__warn">
                                📍 Adresse nicht gefunden, deshalb nicht eingeplant:
                                @string.Join(", ", plan.UnlocatedOrderNumbers.Select(n => $"#{n}"))
                                – bitte Adresse prüfen oder von Hand zuteilen.
                            </div>
                        }
                        @if (plan.ApproximateOrderNumbers.Any())
                        {
                            <div class="av-plan-result__warn">
                                ℹ️ Hausnummer nicht exakt gefunden, Position ungefähr:
                                @string.Join(", ", plan.ApproximateOrderNumbers.Select(n => $"#{n}"))
                            </div>
                        }
                    }
                </div>
            }
        }

        @if (pickupRequests == null)
        {
            <div class="av-state-card av-state-card--info">
                <div class="av-state-card__icon">⏳</div>
                <div class="av-state-card__content"><h3>Wird geladen...</h3></div>
            </div>
        }
        else if (!RoutePickups.Any())
        {
            <div class="av-state-card av-state-card--empty">
                <div class="av-state-card__icon">🗺️</div>
                <div class="av-state-card__content">
                    <h3>Keine Abholaufträge vorhanden</h3>
                    <p>Für den gewählten Filter gibt es keine offenen oder akzeptierten Möbelabholungen.</p>
                </div>
            </div>
        }
        else if (!routeDate.HasValue)
        {
            @* FLACHE ANSICHT: kein Datum gewählt *@
            var flatList = RoutePickups.ToList();
            <div class="av-route-summary">
                <span>📦 <strong>@flatList.Count</strong> Abholungen</span>
                <span class="av-route-summary__hint">Bitte Datum wählen für Fahrzeugaufteilung</span>
                <a href="@BuildMapsUrl()" target="_blank" rel="noopener noreferrer" class="av-maps-btn av-maps-btn--sm" style="margin-left:auto">
                    🗺️ In Google Maps
                </a>
            </div>
            @RouteTable(flatList, showVehicleColumn: false)
        }
        else
        {
            @* GRUPPIERTE ANSICHT: nach Fahrzeug aufgeteilt *@
            var allPickups  = RoutePickups.ToList();
            var dayVehicles = VehiclesOnRouteDay;
            var unassigned  = allPickups
                .Where(r => r.AssignedVehicleId == null ||
                            !dayVehicles.Any(v => v.Id == r.AssignedVehicleId))
                .OrderBy(r => r.PostalCode).ToList();

            @if (!dayVehicles.Any())
            {
                <div class="av-state-card av-state-card--info">
                    <div class="av-state-card__icon">🚗</div>
                    <div class="av-state-card__content">
                        <h3>Keine Fahrzeuge für diesen Tag erfasst</h3>
                        <p>Trage im Tab «Einsatzplan» Fahrzeuge für dieses Datum ein, damit die automatische Aufteilung funktioniert.</p>
                    </div>
                </div>
            }

            @foreach (var v in dayVehicles)
            {
                var veh     = v;
                var vPickups = allPickups.Where(r => r.AssignedVehicleId == veh.Id)
                    .OrderBy(r => r.RouteStopOrder ?? int.MaxValue).ThenBy(r => r.PostalCode).ToList();
                var vSummary = CurrentPlan?.Vehicles.FirstOrDefault(s => s.VehicleId == veh.Id);
                <div class="av-vehicle-group">
                    <div class="av-vehicle-group__header">
                        <div class="av-vehicle-group__info">
                            <span>🚗</span>
                            <strong>@veh.OwnerName</strong>
                            @if (!string.IsNullOrEmpty(veh.OwnerPhone))
                            {
                                <span style="font-size:.85rem">📞 @veh.OwnerPhone</span>
                            }
                            @if (!string.IsNullOrEmpty(veh.OwnerContact))
                            {
                                <small style="color:var(--color-text-light)">@veh.OwnerContact</small>
                            }
                            <span class="av-badge av-badge--driver">@vPickups.Count Stopps</span>
                            @if (vSummary is { Stops: > 0 })
                            {
                                <span class="av-route-stats" title="Fahrzeit inkl. Ladezeit und Rückfahrt">
                                    ⏱️ ≈ @FormatDuration(vSummary.Seconds) · @((vSummary.Meters / 1000).ToString("0.0")) km
                                </span>
                            }
                        </div>
                        @if (vPickups.Any())
                        {
                            <a href="@BuildVehicleMapsUrl(veh.Id)" target="_blank" rel="noopener noreferrer"
                               class="av-maps-btn av-maps-btn--sm">
                                🗺️ Route öffnen
                            </a>
                        }
                    </div>

                    @if (!vPickups.Any())
                    {
                        <div style="padding:.75rem 1.25rem;color:var(--color-text-light);font-size:.88rem;font-style:italic">
                            Noch keine Abholungen zugewiesen
                        </div>
                    }
                    else
                    {
                        @RouteTable(vPickups, showVehicleColumn: true)
                    }
                </div>
            }

            @if (unassigned.Any())
            {
                <div class="av-vehicle-group av-vehicle-group--unassigned">
                    <div class="av-vehicle-group__header">
                        <div class="av-vehicle-group__info">
                            <span>❓</span>
                            <strong>Nicht zugeteilt</strong>
                            <span class="av-badge av-badge--pending">@unassigned.Count Aufträge</span>
                        </div>
                    </div>
                    @RouteTable(unassigned, showVehicleColumn: true)
                </div>
            }
        }
    }

</div>

<!-- ════════════════════════════════════════════════════════════════════════
     EDIT MODAL — FAHRZEUG (Stammdaten)
════════════════════════════════════════════════════════════════════════════ -->
@if (editVehicle != null)
{
    <div class="av-modal-backdrop" @onclick="CloseEditVehicle">
        <div class="av-modal" @onclick:stopPropagation="true">

            <div class="av-modal__header">
                <h3>✏️ Fahrzeug bearbeiten</h3>
                <button class="av-modal__close" @onclick="CloseEditVehicle">✕</button>
