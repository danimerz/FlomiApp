<!-- ════════════════════════════════════════════════════════════════════════
     MODAL — EINSATZTAG (ein Feld im Einsatzplan)
════════════════════════════════════════════════════════════════════════════ -->
@if (cellVehicle != null)
{
    var driverHint = CrewHint(cellEdit.DriverUserId, cellEdit.DriverName, planDrivers, "Fahrer");
    var helperHint = CrewHint(cellEdit.HelperUserId, cellEdit.HelperName, planHelpers, "Beifahrer");
    <div class="av-modal-backdrop" @onclick="CloseCell">
        <div class="av-modal av-modal--narrow" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="cell-title">

            <div class="av-modal__header">
                <h3 id="cell-title">🚗 @cellVehicle.OwnerName · @cellDate.ToString("dddd, dd.MM.yyyy")</h3>
                <button class="av-modal__close" @onclick="CloseCell" aria-label="Schliessen">✕</button>
            </div>

            <div class="av-modal__body">
                @if (cellError != null)
                {
                    <div class="av-state-card av-state-card--error" style="margin-bottom:1rem">
                        <div class="av-state-card__icon">⚠️</div>
                        <div class="av-state-card__content"><p>@cellError</p></div>
                    </div>
                }

                <div class="av-form-grid">
                    <div class="av-field">
                        <label for="cell-driver">🧑‍✈️ Fahrer</label>
                        <input id="cell-driver" class="av-input" list="cell-driver-list" autocomplete="off"
                               placeholder="Name tippen oder wählen"
                               value="@cellDriverText"
                               @onchange="e => OnCellDriverChanged(e.Value?.ToString())" />
                        <datalist id="cell-driver-list">
                            @foreach (var u in CrewSuggestions(planDrivers))
                            {
                                <option value="@FullName(u.User)">@u.Label</option>
                            }
                        </datalist>
                        @if (driverHint.Text.Length > 0)
                        {
                            <small class="av-hint @driverHint.Css">@driverHint.Text</small>
                        }
                    </div>
                    <div class="av-field">
                        <label for="cell-driver-phone">📞 Telefon Fahrer</label>
                        <input id="cell-driver-phone" class="av-input"
                               placeholder="wird vom Konto übernommen"
                               value="@cellEdit.DriverPhone"
                               @onchange="e => cellEdit.DriverPhone = PhoneHelper.FormatSwissPhone(e.Value?.ToString())" />
                    </div>
                    <div class="av-field">
                        <label for="cell-helper">🙋 Helfer</label>
                        <input id="cell-helper" class="av-input" list="cell-helper-list" autocomplete="off"
                               placeholder="Name tippen oder wählen"
                               value="@cellHelperText"
                               @onchange="e => OnCellHelperChanged(e.Value?.ToString())" />
                        <datalist id="cell-helper-list">
                            @foreach (var u in CrewSuggestions(planHelpers))
                            {
                                <option value="@FullName(u.User)">@u.Label</option>
                            }
                        </datalist>
                        @if (helperHint.Text.Length > 0)
                        {
                            <small class="av-hint @helperHint.Css">@helperHint.Text</small>
                        }
                    </div>
                </div>

                <details class="av-more" open="@cellShowMore">
                    <summary>Mehr: Bereit ab, Abholen und Zurückbringen</summary>
                    <div class="av-form-grid">
                        <div class="av-field">
                            <label for="cell-ready">Bereit ab</label>
                            <input id="cell-ready" class="av-input"
                                   value="@cellEdit.ReadyFrom"
                                   placeholder="z.B. 08:00"
                                   @onchange="e => cellEdit.ReadyFrom = TimeHelper.FormatTime(e.Value?.ToString())" />
                        </div>
                        <div class="av-field">
                            <label for="cell-pickedup">Abgeholt durch</label>
                            <input id="cell-pickedup" class="av-input" @bind="cellEdit.PickedUpBy" placeholder="Name der Person" />
                        </div>
                        <div class="av-field">
                            <label for="cell-returned">Zurückgebracht durch</label>
                            <input id="cell-returned" class="av-input" @bind="cellEdit.ReturnedBy" placeholder="Name der Person" />
                        </div>
