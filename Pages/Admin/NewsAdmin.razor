@page "/admin/news"
@using FlomiApp.Data.Models
@using Microsoft.AspNetCore.Authorization
@inject INewsService NewsService
@using FlomiApp.Security
@attribute [Authorize(Roles = Roles.Admin)]
@attribute [Authorize(Policy = Roles.RequireTwoFactorForAdmins)]

<PageTitle>News – Admin</PageTitle>

<div class="dashboard-page">

    <section class="dashboard-hero">
        <div class="dashboard-hero__content">
            <span class="dashboard-hero__badge">Administration</span>
            <h1>News</h1>
            <p>Verwalte Meldungen und Neuigkeiten für die Startseite.</p>
        </div>
    </section>

    <!-- Toolbar -->
    <div class="ac-toolbar">
        <button class="ac-submit-btn" @onclick="ShowCreate">
            ＋ Neue Meldung
        </button>
    </div>

    @if (showForm)
    {
        <div class="ac-form-card">
            <div class="ac-form-card__header">
                <h3>@(isEditing ? "✏️ Meldung bearbeiten" : "➕ Neue Meldung erstellen")</h3>
            </div>
            <div class="ac-form-card__body">
                <EditForm Model="current" OnValidSubmit="Save">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="ac-validation" />

                    <div class="ac-field" style="margin-bottom:1rem">
                        <label>Titel *</label>
                        <InputText @bind-Value="current.Title" class="ac-input"
                                   placeholder="z.B. Flomi 2027 — Wichtige Info" />
                    </div>
                    <div class="ac-field" style="margin-bottom:1rem">
                        <label>Inhalt *</label>
                        <InputTextArea @bind-Value="current.Content" class="ac-input ac-textarea"
                                       rows="5"
                                       placeholder="Text der Meldung..." />
                    </div>
                    <div class="ac-field" style="margin-bottom:1rem">
                        <label>
                            Bilder
                            <span class="news-img-hint">(max. @INewsService.MaxImages, je max. 10 MB; das erste erscheint auch auf der Startseite)</span>
                        </label>

                        @if (ImageCount < INewsService.MaxImages)
                        {
                            <label class="news-img-upload">
                                <span>@(isProcessing ? "⏳ Bilder werden aufbereitet..." : "📷 Bilder auswählen")</span>
                                <InputFile OnChange="HandleImageUpload" multiple accept="image/*"
                                           class="news-img-upload__input" disabled="@isProcessing" />
                            </label>
                        }

                        @if (imageError != null)
                        {
                            <p class="news-img-error">⚠️ @imageError</p>
                        }

                        @if (ImageCount > 0)
                        {
                            <div class="news-img-grid">
                                @foreach (var img in current.Images.Where(i => !removedImageIds.Contains(i.Id)))
                                {
                                    <div class="news-img-thumb">
                                        <img src="/news-images/@img.Id?thumb=true" alt="@img.FileName" />
                                        <button aria-label="Bild entfernen" type="button" class="news-img-remove" title="Bild entfernen"
                                                @onclick="() => { removedImageIds.Add(img.Id); }">✕</button>
                                    </div>
                                }
                                @foreach (var img in newImages)
                                {
                                    <div class="news-img-thumb news-img-thumb--new">
                                        <img src="@img.PreviewUrl" alt="@img.FileName" />
                                        <button aria-label="Bild entfernen" type="button" class="news-img-remove" title="Bild entfernen"
                                                @onclick="() => { newImages.Remove(img); }">✕</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="ac-checkbox-row">
                        <InputCheckbox @bind-Value="current.IsPublished" id="pubCheck" class="ac-checkbox" />
                        <label for="pubCheck">Sofort veröffentlichen</label>
                    </div>
                    <div class="ac-checkbox-row">
                        <InputCheckbox @bind-Value="current.IsPinned" id="pinCheck" class="ac-checkbox" />
                        <label for="pinCheck">📌 Als wichtig markieren (wird zuerst angezeigt)</label>
                    </div>

                    <div class="ac-form-actions">
                        <button type="submit" class="ac-submit-btn" disabled="@(isSaving || isProcessing)">
                            @(isSaving ? "⏳ Wird gespeichert..." : isEditing ? "💾 Aktualisieren" : "✅ Erstellen")
                        </button>
                        <button type="button" class="ac-cancel-btn" @onclick="Cancel">Abbrechen</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (successMsg != null)
    {
        <div class="ac-state-card ac-state-card--success" style="margin-bottom:1rem">
            <div class="ac-state-card__icon">✅</div>
            <div class="ac-state-card__content"><p>@successMsg</p></div>
        </div>
    }

    @if (news == null)
    {
        <div class="ac-state-card ac-state-card--info">
            <div class="ac-state-card__icon">⏳</div>
            <div class="ac-state-card__content"><h3>Wird geladen...</h3></div>
        </div>
    }
    else if (!news.Any())
    {
        <div class="ac-state-card ac-state-card--empty">
            <div class="ac-state-card__icon">📭</div>
            <div class="ac-state-card__content">
                <h3>Noch keine Meldungen</h3>
                <p>Erstelle eine neue Meldung mit dem Button oben.</p>
            </div>
        </div>
    }
    else
    {
        <table class="ac-table">
            <thead>
                <tr>
                    <th>Titel</th>
                    <th>Erstellt am</th>
                    <th>Status</th>
                    <th>Aktionen</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in news)
                {
                    <tr>
                        <td>
                            @if (item.IsPinned)
                            {
                                <span class="ac-badge ac-badge--pinned" style="margin-right:.4rem">📌 Wichtig</span>
                            }
                            <strong>@item.Title</strong>
                            @if (item.Images.Count > 0)
                            {
                                <span class="news-img-count" title="Bilder">🖼 @item.Images.Count</span>
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (item.IsPublished)
                            {
                                <span class="ac-badge ac-badge--active">✅ Publiziert</span>
                            }
                            else
                            {
                                <span class="ac-badge ac-badge--inactive">🔴 Entwurf</span>
                            }
                        </td>
                        <td>
                            <div class="ac-actions">
                                <button class="ac-btn ac-btn--edit" @onclick="() => Edit(item)">
                                    ✏️ Edit
                                </button>
                                <button class="ac-btn @(item.IsPublished ? "ac-btn--deactivate" : "ac-btn--activate")"
                                        @onclick="() => Toggle(item.Id)">
                                    @(item.IsPublished ? "⏸ Verbergen" : "▶ Publizieren")
                                </button>
                                <button class="ac-btn @(item.IsPinned ? "ac-btn--deactivate" : "ac-btn--pin")"
                                        @onclick="() => Pin(item.Id)"
                                        title="@(item.IsPinned ? "Wichtig-Markierung entfernen" : "Als wichtig markieren")">
                                    @(item.IsPinned ? "📌 Lösen" : "📌 Anpinnen")
                                </button>
                                <button class="ac-btn ac-btn--delete" @onclick="() => Delete(item.Id)">
                                    🗑️ Löschen
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>

@code {
    private List<NewsItem>? news;
    private NewsItem        current    = new() { IsPublished = true };
    private bool            showForm   = false;
    private bool            isEditing  = false;
    private bool            isSaving   = false;
    private string?         successMsg = null;

    // ── Bilder ────────────────────────────────────────────────────────────────
    private sealed record NewImage(string FileName, FlomiApp.Helpers.ProcessedImage Image, string PreviewUrl);

    private List<NewImage> newImages       = new();
    private HashSet<int>   removedImageIds = new();
    private string?        imageError      = null;
    private bool           isProcessing    = false;

    private int ImageCount =>
        current.Images.Count(i => !removedImageIds.Contains(i.Id)) + newImages.Count;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        news = await NewsService.GetAllAsync();
    }

    private void ShowCreate()
    {
        current   = new NewsItem { IsPublished = true };
        isEditing = false;
        showForm  = true;
        successMsg = null;
        ResetImages();
    }

    private void Edit(NewsItem item)
    {
        current   = new NewsItem { Id = item.Id, Title = item.Title, Content = item.Content, IsPublished = item.IsPublished, IsPinned = item.IsPinned, Images = item.Images.ToList() };
        isEditing = true;
        showForm  = true;
        successMsg = null;
        ResetImages();
    }

    private void Cancel()
    {
        showForm  = false;
        isEditing = false;
        current   = new NewsItem { IsPublished = true };
        ResetImages();
    }

    private void ResetImages()
    {
        newImages       = new();
        removedImageIds = new();
        imageError      = null;
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        imageError = null;
        const long maxSizeBytes = 10 * 1024 * 1024;

        var free  = INewsService.MaxImages - ImageCount;
        var files = e.GetMultipleFiles(INewsService.MaxImages + 10);
        if (files.Count > free)
            imageError = $"Maximal {INewsService.MaxImages} Bilder pro Meldung, nur die ersten {free} werden übernommen.";

        isProcessing = true;
        try
        {
            foreach (var file in files.Take(free))
            {
                if (file.Size > maxSizeBytes)
                {
                    imageError = $"«{file.Name}» ist zu gross (max. 10 MB).";
                    continue;
                }

                using var stream = file.OpenReadStream(maxSizeBytes);
                using var ms     = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                // Format anhand der Datei-Signatur prüfen, dann verkleinern und GPS-Daten entfernen
                var processed = FlomiApp.Helpers.ImageSignatureHelper.DetectContentType(bytes) == null
                    ? null
                    : await Task.Run(() => FlomiApp.Helpers.PickupImageProcessor.Process(bytes));
                if (processed == null)
                {
                    imageError = $"«{file.Name}» ist kein erlaubtes Bildformat (JPEG, PNG, WebP, GIF).";
                    continue;
                }

                newImages.Add(new NewImage(file.Name, processed,
                    $"data:{FlomiApp.Helpers.ProcessedImage.ContentType};base64,{Convert.ToBase64String(processed.Thumbnail)}"));
            }
        }
        finally { isProcessing = false; }
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            var images = newImages.Select(i => (i.Image, i.FileName)).ToList();
            if (isEditing)
            {
                await NewsService.UpdateAsync(current, images, removedImageIds);
                successMsg = $"Meldung «{current.Title}» wurde aktualisiert.";
            }
            else
            {
                await NewsService.CreateAsync(current, images);
                successMsg = $"Meldung «{current.Title}» wurde erstellt.";
            }
            await Load();
            Cancel();
        }
        finally { isSaving = false; }
    }

    private async Task Toggle(int id)
    {
        await NewsService.TogglePublishedAsync(id);
        await Load();
    }

    private async Task Delete(int id)
    {
        await NewsService.DeleteAsync(id);
        await Load();
    }

    private async Task Pin(int id)
    {
        await NewsService.TogglePinnedAsync(id);
        await Load();
    }
}
