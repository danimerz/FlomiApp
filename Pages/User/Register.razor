@page "/user/register"
@using FlomiApp.Data.Models
@using FlomiApp.Helpers
@using Microsoft.AspNetCore.Identity
@inject IAreaService AreaService
@inject IAppointmentService AppointmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Terminbuchung</PageTitle>

<div class="register-page">
    <section class="register-hero">
        <div class="register-hero__content">
            <span class="register-hero__badge">Anmeldung</span>
            <h1>Terminbuchung</h1>
            <p>
                Wähle ein Event, bestimme die Person und registriere dich für einen verfügbaren Bereich.
            </p>
        </div>
    </section>

    @if (currentUser != null && !currentUser.HasSeenRegisterOnboarding)
    {
        <section class="onboarding-panel">
            <button class="onboarding-panel__close" @onclick="DismissOnboarding" aria-label="Schliessen">✕</button>
            <h2>👋 Kurz erklärt, bevor du startest</h2>
            <div class="onboarding-panel__grid">
                <div class="onboarding-panel__item">
                    <span class="onboarding-panel__icon">🗂</span>
                    <div>
                        <strong>Kategorie</strong>
                        <p>Die grobe Art des Einsatzes — z.B. Sammeln, Sortieren, Verkauf oder Fahrer. Jeder Bereich gehört zu genau einer Kategorie.</p>
                    </div>
                </div>
                <div class="onboarding-panel__item">
                    <span class="onboarding-panel__icon">📍</span>
                    <div>
                        <strong>Bereich</strong>
                        <p>Der konkrete Einsatz innerhalb einer Kategorie — z.B. «Geschirr» oder «Spielzeug» —, für den du dich mit Datum und Zeit anmeldest.</p>
                    </div>
                </div>
                <div class="onboarding-panel__item">
                    <span class="onboarding-panel__icon">🕓</span>
                    <div>
                        <strong>Halbtagsschicht</strong>
                        <p>Manche Bereiche lassen sich statt als ganzer Tag auch als halber Tag buchen — erkennbar am Umschalter bei der Anmeldung.</p>
                    </div>
                </div>
            </div>
            <button class="onboarding-panel__dismiss" @onclick="DismissOnboarding">Verstanden, los geht's!</button>
        </section>
    }

    @if (events == null)
    {
        <div class="state-card state-card--info">
            <div class="state-card__icon">ℹ️</div>
            <div class="state-card__content">
                <h3>Events werden geladen</h3>
                <p>Bitte einen kleinen Moment Geduld.</p>
            </div>
        </div>
    }
    else if (!events.Any())
    {
        <div class="state-card state-card--empty">
            <div class="state-card__icon">📭</div>
            <div class="state-card__content">
                <h3>Keine Events verfügbar</h3>
                <p>Aktuell stehen keine aktiven Events zur Auswahl bereit.</p>
            </div>
        </div>
    }
    else
    {
        <section class="selection-panel">
            <div class="selection-card">
                <label for="event-select">Event auswählen</label>
                <select id="event-select" class="custom-select" value="@selectedEventId"
                        @onchange="OnEventChanged">
                    @foreach (var evt in events)
                    {
                        <option value="@evt.Id">@evt.Name (@evt.Date.ToShortDateString())</option>
                    }
                </select>
            </div>

            <div class="selection-card">
                <label for="person-select">Registrieren als</label>
                <select id="person-select" class="custom-select" value="@selectedMemberId"
                        @onchange="OnPersonChanged">
                    <option value="0">Ich selbst</option>
                    @foreach (var member in familyMembers)
                    {
                        <option value="@member.Id">
                            @member.FirstName @member.LastName (@member.Stufe)
                        </option>
                    }
                </select>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="state-card state-card--success">
                <div class="state-card__icon">✅</div>
                <div class="state-card__content">
                    <h3>Registrierung erfolgreich</h3>
                    <p>@successMessage</p>
                </div>
            </div>
        }

        @if (selectedEvent != null)
        {
            <section class="event-summary">
                <div class="event-summary__topline">Ausgewähltes Event</div>
                <h2>@selectedEvent.Name</h2>
                <div class="event-summary__meta">
                    <span class="event-pill">📅 @selectedEvent.Date.ToShortDateString()</span>
                </div>
                <p>@selectedEvent.Description</p>
            </section>
        }

        @if (areas == null)
        {
            <div class="state-card state-card--info">
                <div class="state-card__icon">⏳</div>
                <div class="state-card__content">
                    <h3>Bereiche werden geladen</h3>
                    <p>Die verfügbaren Bereiche für das gewählte Event werden vorbereitet.</p>
                </div>
            </div>
        }
        else if (!areas.Any())
        {
            <div class="state-card state-card--empty">
                <div class="state-card__icon">🗂️</div>
                <div class="state-card__content">
                    <h3>Keine Bereiche verfügbar</h3>
                    <p>Für dieses Event sind derzeit keine Bereiche hinterlegt.</p>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="state-card state-card--error">
                    <div class="state-card__icon">⚠️</div>
                    <div class="state-card__content">
                        <h3>Aktion nicht möglich</h3>
                        <p>@errorMessage</p>
                    </div>
                </div>
            }

            @foreach (var group in areas
                .OrderBy(a => a.AreaTemplate?.AreaCategory?.SortOrder ?? 999)
                .ThenBy(a => a.AreaTemplate?.AreaCategory?.Name)
                .GroupBy(a => a.AreaTemplate?.AreaCategory?.Name ?? "Sonstiges"))
            {
                var categoryKey = group.Key;
                var isCollapsed = collapsedCategories.Contains(categoryKey);
                var isList      = !tileCategories.Contains(categoryKey);

                <section class="category-block @(isCollapsed ? "is-collapsed" : "")" data-category="@categoryKey">
                    <div class="category-block__header"
                         @onclick="() => ToggleCategory(categoryKey)">
                        <h3>🎪 @group.Key</h3>
                        <div class="category-block__header-right">
                            @* Ansicht umschalten – Klick soll die Kategorie nicht auf-/zuklappen *@
                            <div class="view-switch" role="group" aria-label="Ansicht für @group.Key"
                                 @onclick:stopPropagation="true">
                                <button type="button"
                                        class="view-switch__btn @(isList ? "" : "is-active")"
                                        aria-pressed="@(isList ? "false" : "true")"
                                        title="Als Kacheln anzeigen"
                                        @onclick="() => SetViewMode(categoryKey, false)">
                                    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="1.5" width="5.5" height="5.5" rx="1.2"/><rect x="9" y="1.5" width="5.5" height="5.5" rx="1.2"/><rect x="1.5" y="9" width="5.5" height="5.5" rx="1.2"/><rect x="9" y="9" width="5.5" height="5.5" rx="1.2"/></svg>
                                    <span class="view-switch__text">Kacheln</span>
                                </button>
                                <button type="button"
                                        class="view-switch__btn @(isList ? "is-active" : "")"
                                        aria-pressed="@(isList ? "true" : "false")"
                                        title="Als Liste anzeigen"
                                        @onclick="() => SetViewMode(categoryKey, true)">
                                    <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="2.2" rx="1.1"/><rect x="1.5" y="6.9" width="13" height="2.2" rx="1.1"/><rect x="1.5" y="11.3" width="13" height="2.2" rx="1.1"/></svg>
                                    <span class="view-switch__text">Liste</span>
                                </button>
                            </div>
                            <span class="category-block__count">@group.Count() Bereiche</span>
                            <span class="category-block__toggle-icon">▾</span>
                        </div>
                    </div>

                    <div class="category-block__body">
                        @* Spontane Bereiche (ohne Datum/Zeit) als eigene Gruppe zuoberst *@
                        @foreach (var dateGroup in group
                            .OrderByDescending(a => a.IsSpontaneous)
                            .ThenBy(a => a.Date)
                            .GroupBy(a => a.IsSpontaneous ? SpontaneousGroupKey : a.Date.ToShortDateString()))
                        {
                            <div class="date-subgroup">
                                @if (dateGroup.Key == SpontaneousGroupKey)
                                {
                                    <h4>🙋 Spontan – ohne fixes Datum und Zeit</h4>
                                }
                                else
                                {
                                    <h4>📅 @GetGermanDayName(dateGroup.Key), @dateGroup.Key</h4>
                                }

                                @if (isList)
                                {
                                    <div class="area-list">
                                        <div class="area-list__head" aria-hidden="true">
                                            <span>Bereich</span>
                                            <span>Zeit</span>
                                            <span>Belegt</span>
                                            <span>Mindestalter</span>
                                            <span>Standort</span>
                                            <span></span>
                                        </div>
                                        @foreach (var area in dateGroup)
                                        {
                                            var slot = GetSlot(area);
                                            var note = GetRegistrationNote(area);
                                            <div class="area-row">
                                                <div class="area-row__name">
                                                    <span class="area-row__title">@area.AreaTemplate?.Name</span>
                                                    @if (!string.IsNullOrEmpty(note))
                                                    {
                                                        <span class="area-row__note">@note</span>
                                                    }
                                                </div>
                                                <div class="area-row__cell" data-label="Zeit">
                                                    <span>@slot.Time</span>
                                                    @if (slot.AltOk)
                                                    {
                                                        @SlotToggle(area, slot, compact: true)
                                                    }
                                                </div>
                                                <div class="area-row__cell" data-label="Belegt">@CapacityChip(slot)</div>
                                                <div class="area-row__cell" data-label="Mindestalter">
                                                    @((area.AreaTemplate?.MinAge ?? 0) > 0 ? $"{area.AreaTemplate!.MinAge} Jahre" : "–")
                                                </div>
                                                <div class="area-row__cell" data-label="Standort">
                                                    @(string.IsNullOrEmpty(area.AreaTemplate?.Location) ? "–" : area.AreaTemplate!.Location)
                                                </div>
                                                <div class="area-row__action">@RegisterAction(area, slot, area.IsSpontaneous ? "🙋 Ich komme spontan" : "Registrieren")</div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="area-grid">
                                        @foreach (var area in dateGroup)
                                        {
                                            var slot = GetSlot(area);
                                            <article class="area-card">
                                                <div class="area-card__body">
                                                    <div class="area-card__header">
                                                        <h4>@area.AreaTemplate?.Name</h4>
                                                        <span class="area-category">
                                                            @(area.AreaTemplate?.AreaCategory?.Name ?? "–")
                                                        </span>
                                                    </div>

                                                    @if (slot.AltOk)
                                                    {
                                                        @SlotToggle(area, slot, compact: false)
                                                    }

                                                    <div class="area-info-list">
                                                        <div class="area-info-item">
                                                            <span class="label">Datum</span>
                                                            <span class="value">@(area.IsSpontaneous ? "spontan" : area.Date.ToShortDateString())</span>
                                                        </div>
                                                        <div class="area-info-item">
                                                            <span class="label">Zeit</span>
                                                            <span class="value">@slot.Time</span>
                                                        </div>
                                                        <div class="area-info-item">
                                                            <span class="label">Belegt</span>
                                                            <span class="value">@CapacityChip(slot)</span>
                                                        </div>
                                                        @if ((area.AreaTemplate?.MinAge ?? 0) > 0)
                                                        {
                                                            <div class="area-info-item">
                                                                <span class="label">Mindestalter</span>
                                                                <span class="value">@area.AreaTemplate!.MinAge Jahre</span>
                                                            </div>
                                                        }
                                                        @if (!string.IsNullOrEmpty(area.AreaTemplate?.Location))
                                                        {
                                                            <div class="area-info-item">
                                                                <span class="label">Standort</span>
                                                                <span class="value">@area.AreaTemplate!.Location</span>
                                                            </div>
                                                        }
                                                    </div>

                                                    @RegisterAction(area, slot, area.IsSpontaneous ? "🙋 Ich komme spontan vorbei" : "Jetzt registrieren")

                                                    @if (!string.IsNullOrEmpty(GetRegistrationNote(area)))
                                                    {
                                                        <p class="registration-note">
                                                            @GetRegistrationNote(area)
                                                        </p>
                                                    }
                                                </div>
                                            </article>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </section>
            }
        }
    }
</div>

@* ── Bestätigungs-Modal ── *@
@if (confirmArea != null)
{
    <div class="reg-modal-backdrop" @onclick="CloseConfirmModal">
        <div class="reg-modal" @onclick:stopPropagation="true">
            <div class="reg-modal__header">
                <h3>📋 Anmeldung bestätigen</h3>
                <button class="reg-modal__close" @onclick="CloseConfirmModal">✕</button>
            </div>
            <div class="reg-modal__body">
                <div class="reg-modal__info">
                    <div class="reg-modal__info-row">
                        <span class="reg-modal__label">Bereich</span>
                        <span class="reg-modal__value"><strong>@confirmArea.AreaTemplate?.Name</strong></span>
                    </div>
                    <div class="reg-modal__info-row">
                        <span class="reg-modal__label">Datum</span>
                        <span class="reg-modal__value">@AreaSchedule.FormatDate(AreaSchedule.Date(confirmArea), "dddd, dd.MM.yyyy")</span>
                    </div>
                    <div class="reg-modal__info-row">
                        <span class="reg-modal__label">Zeit</span>
                        <span class="reg-modal__value">
                            @AreaSchedule.TimeSlot(confirmArea, confirmUseAlt)
                            @if (confirmUseAlt)
                            {
                                <span style="margin-left:.4rem;font-size:.75rem;color:var(--color-info-text);font-weight:600">
                                    (Halber Tag)
                                </span>
                            }
                        </span>
                    </div>
                    @if (selectedMemberId > 0)
                    {
                        var member = familyMembers.FirstOrDefault(m => m.Id == selectedMemberId);
                        @if (member != null)
                        {
                            <div class="reg-modal__info-row">
                                <span class="reg-modal__label">Person</span>
                                <span class="reg-modal__value">@member.FirstName @member.LastName</span>
                            </div>
                        }
                    }
                </div>

                <div class="reg-modal__comment">
                    <label for="reg-comment">Kommentar <span class="reg-modal__optional">(optional)</span></label>
                    <textarea id="reg-comment"
                              class="reg-modal__textarea"
                              rows="3"
                              maxlength="500"
                              placeholder="z.B. «Bringe Helfer mit», ..."
                              @bind="confirmComment"></textarea>
                </div>
            </div>
            <div class="reg-modal__footer">
                <button class="register-btn" @onclick="ConfirmRegistration"
                        disabled="@registeringAreaId.HasValue">
                    @if (registeringAreaId.HasValue)
                    {
                        <span>⏳ Wird registriert...</span>
                    }
                    else
                    {
                        <span>✅ Jetzt registrieren</span>
                    }
                </button>
                <button class="reg-modal__cancel-btn" @onclick="CloseConfirmModal">
                    Abbrechen
                </button>
            </div>
        </div>
    </div>
}

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private List<Event>?         events               = null;
    private Event?               selectedEvent;
    private int                  selectedEventId;
    private List<Area>?          areas;
    private List<FamilyMember>   familyMembers        = new();
    private int                  selectedMemberId     = 0;
    private Dictionary<int, int> currentRegistrations = new();
    private Dictionary<int,bool> canRegister          = new();
    private string               userId               = string.Empty;
    private ApplicationUser?     currentUser;
    private int?                 selectedPersonAge;
    private string               errorMessage         = string.Empty;
    private string               successMessage       = string.Empty;
    private CancellationTokenSource? successMessageCts;
    private HashSet<string>      collapsedCategories  = new();

    // Standard ist die Liste; Kategorien, die als Kacheln angezeigt werden (pro Browser gemerkt)
    private HashSet<string>      tileCategories       = new();
    private const string         TileViewStorageKey   = "flomi.register.tileCategories";
    private const string         SpontaneousGroupKey  = "spontan";

    // ── Loading State ─────────────────────────────────────────────────────────
    private int? registeringAreaId = null;

    // ── Bestätigungs-Modal ────────────────────────────────────────────────────
    private Area?   confirmArea         = null;
    private string  confirmComment      = string.Empty;
    private bool    confirmUseAlt       = false;

    // ── Alternative Zeitslot-Auswahl ──────────────────────────────────────────
    private Dictionary<int, bool>  useAltSlot       = new(); // areaId → true = alternativ
    private Dictionary<int, int>   altRegistrations = new(); // areaId → Anzahl
    private Dictionary<int, bool>  canRegisterAlt   = new(); // areaId → canRegister für Alt-Slot

    private void OpenConfirmModal(Area area)
    {
        confirmArea    = area;
        confirmComment = string.Empty;
        confirmUseAlt  = useAltSlot.GetValueOrDefault(area.Id, false);
    }

    private void CloseConfirmModal()
    {
        confirmArea    = null;
        confirmComment = string.Empty;
        confirmUseAlt  = false;
    }

    private async Task ConfirmRegistration()
    {
        if (confirmArea == null) return;
        var areaId  = confirmArea.Id;
        var comment = confirmComment;
        var useAlt  = confirmUseAlt;
        CloseConfirmModal();
        await RegisterAppointment(areaId, comment, useAlt);
    }

    private bool IsAlternativeAllowed(Area area)
    {
        if (string.IsNullOrEmpty(area.AreaTemplate?.MandatoryStufen)) return true;
        var mandatory = area.AreaTemplate.MandatoryStufen
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var stufe = selectedMemberId == 0
            ? currentUser?.Stufe
            : familyMembers.FirstOrDefault(m => m.Id == selectedMemberId)?.Stufe;
        return !mandatory.Contains(stufe ?? "", StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleAltSlot(int areaId)
    {
        useAltSlot[areaId] = !useAltSlot.GetValueOrDefault(areaId, false);
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            userId        = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
                            ?? string.Empty;
            currentUser   = await UserManager.GetUserAsync(user);
            familyMembers = await AppointmentService.GetFamilyMembersAsync(userId);
            UpdateSelectedPersonAge();

            events = (await AreaService.GetAllEventsAsync())
                .Where(e => e.IsActive)
                .OrderBy(e => e.Date)
                .ToList();

            if (events.Any())
            {
                selectedEventId = events[0].Id;
                selectedEvent   = events[0];
                await LoadAreasForSelectedEvent();
            }
        }
    }

    // ── Onboarding ───────────────────────────────────────────────────────────
    private async Task DismissOnboarding()
    {
        if (currentUser == null) return;
        currentUser.HasSeenRegisterOnboarding = true;
        await UserManager.UpdateAsync(currentUser);
    }

    // ── Event-Wechsel ─────────────────────────────────────────────────────────
    private async Task OnEventChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var eventId))
        {
            selectedEventId = eventId;
            selectedEvent   = events?.FirstOrDefault(evt => evt.Id == selectedEventId);
            successMessage  = string.Empty;
            await LoadAreasForSelectedEvent();
            StateHasChanged();
        }
    }

    // ── Person-Wechsel ────────────────────────────────────────────────────────
    private async Task OnPersonChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var memberId))
        {
            selectedMemberId = memberId;
            UpdateSelectedPersonAge();
            successMessage = string.Empty;
            await LoadAreasForSelectedEvent();
            StateHasChanged();
        }
    }

    private void UpdateSelectedPersonAge()
    {
        if (selectedMemberId == 0)
        {
            selectedPersonAge = currentUser?.Birthday.HasValue == true
                ? CalculateAge(currentUser!.Birthday!.Value, DateTime.Today)
                : null;
            return;
        }

        var selectedMember = familyMembers.FirstOrDefault(m => m.Id == selectedMemberId);
        selectedPersonAge  = selectedMember != null
            ? CalculateAge(selectedMember.Birthday, DateTime.Today)
            : null;
    }

    // ── Bereiche laden ────────────────────────────────────────────────────────
    private async Task LoadAreasForSelectedEvent()
    {
        errorMessage = string.Empty;
        areas        = await AreaService.GetAreasByEventAsync(selectedEventId) ?? new List<Area>();

        currentRegistrations.Clear();
        canRegister.Clear();
        canRegisterAlt.Clear();

        foreach (var area in areas)
        {
            currentRegistrations[area.Id] = await AreaService.GetCurrentRegistrationsAsync(area.Id, false);
            altRegistrations[area.Id]     = await AreaService.GetCurrentRegistrationsAsync(area.Id, true);
            var memberId = selectedMemberId == 0 ? (int?)null : selectedMemberId;
            canRegister[area.Id]    = await AppointmentService.CanRegisterAsync(userId, area.Id, memberId);
            canRegisterAlt[area.Id] = await AppointmentService.CanRegisterAsync(userId, area.Id, memberId, true);
        }

        collapsedCategories = areas
            .Select(a => a.AreaTemplate?.AreaCategory?.Name ?? "Sonstiges")
            .ToHashSet();
    }

    // ── Registrierung mit Loading ─────────────────────────────────────────────
    private async Task RegisterAppointment(int areaId, string? comment = null, bool useAlternative = false)
    {
        registeringAreaId = areaId;
        StateHasChanged();

        try
        {
            await AppointmentService.RegisterForAppointmentAsync(
                userId, areaId,
                selectedMemberId == 0 ? null : selectedMemberId,
                comment,
                useAlternative);

            errorMessage = string.Empty;
            await LoadAreasForSelectedEvent();
            await JS.InvokeVoidAsync("scrollToTop");
            await ShowTemporarySuccessMessageAsync(
                "Du wurdest erfolgreich für den Bereich registriert.");
        }
        catch (Exception ex)
        {
            errorMessage   = ex.Message;
            successMessage = string.Empty;
            successMessageCts?.Cancel();
        }
        finally
        {
            registeringAreaId = null;
            StateHasChanged();
        }
    }

    private async Task ShowTemporarySuccessMessageAsync(string message)
    {
        successMessageCts?.Cancel();
        successMessageCts = new CancellationTokenSource();

        successMessage = message;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, successMessageCts.Token);
            successMessage = string.Empty;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    // ── Kategorie ein-/ausklappen ─────────────────────────────────────────────
    // Akkordeon: Es ist immer höchstens eine Kategorie offen
    private async Task ToggleCategory(string categoryKey)
    {
        if (collapsedCategories.Contains(categoryKey))
            await ExpandOnlyAsync(categoryKey);
        else
            collapsedCategories.Add(categoryKey);
    }

    private async Task ExpandOnlyAsync(string categoryKey)
    {
        var wasOpen = !collapsedCategories.Contains(categoryKey);

        collapsedCategories = (areas ?? new List<Area>())
            .Select(a => a.AreaTemplate?.AreaCategory?.Name ?? "Sonstiges")
            .Where(key => key != categoryKey)
            .ToHashSet();

        // Klappt eine Kategorie darüber zu, rutscht die geöffnete aus dem Bild – zurückholen
        if (!wasOpen)
        {
            try { await JS.InvokeVoidAsync("scrollCategoryIntoView", categoryKey); }
            catch (JSException) { /* Scrollen ist nur Komfort */ }
        }
    }

    // ── Ansicht Kacheln/Liste ─────────────────────────────────────────────────
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", TileViewStorageKey);
            if (!string.IsNullOrEmpty(stored))
            {
                tileCategories = stored.Split('|', StringSplitOptions.RemoveEmptyEntries).ToHashSet();
                StateHasChanged();
            }
        }
        catch
        {
            // Kein localStorage (z.B. privater Modus) – dann bleibt es bei der Liste
        }
    }

    private async Task SetViewMode(string categoryKey, bool asList)
    {
        if (asList) tileCategories.Remove(categoryKey);
        else        tileCategories.Add(categoryKey);

        // Wer die Ansicht wählt, will die Bereiche auch sehen
        await ExpandOnlyAsync(categoryKey);

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", TileViewStorageKey, string.Join('|', tileCategories));
        }
        catch
        {
            // Merken ist nur Komfort
        }
    }

    // ── Anzeige-Werte pro Bereich (ganzer oder halber Tag) ───────────────────
    private sealed record SlotInfo(bool AltOk, bool IsAlt, string? Time, int Registered, int Capacity, bool CanRegister);

    private SlotInfo GetSlot(Area area)
    {
        var hasAlt = !area.IsSpontaneous && !string.IsNullOrEmpty(area.AlternativeTimeSlot) && area.AlternativeMaxCapacity.HasValue;
        var altOk  = hasAlt && IsAlternativeAllowed(area);
        var isAlt  = altOk && useAltSlot.GetValueOrDefault(area.Id, false);

        return isAlt
            ? new SlotInfo(altOk, true, area.AlternativeTimeSlot,
                           altRegistrations.GetValueOrDefault(area.Id, 0), area.AlternativeMaxCapacity!.Value,
                           canRegisterAlt.GetValueOrDefault(area.Id, false))
            : new SlotInfo(altOk, false, AreaSchedule.TimeSlot(area),
                           currentRegistrations.GetValueOrDefault(area.Id, 0), area.MaxCapacity,
                           canRegister.GetValueOrDefault(area.Id, false));
    }

    // ── Bausteine für Kachel- und Listenansicht ──────────────────────────────
    private RenderFragment CapacityChip(SlotInfo slot) =>
        @<text>
            @if (slot.Capacity >= 999)
            {
                <span class="capacity-chip capacity-chip--unlimited">∞ Unbegrenzt</span>
            }
            else
            {
                <span class="capacity-chip">@slot.Registered / @slot.Capacity</span>
            }
        </text>;

    private RenderFragment SlotToggle(Area area, SlotInfo slot, bool compact) =>
        @<div class="area-slot-toggle @(compact ? "area-slot-toggle--compact" : "")">
            <span class="area-slot-toggle__label">
                @(slot.IsAlt ? "⏰ Halber Tag" : "⏰ Ganzer Tag")
            </span>
            <label class="toggle-switch" title="Zeitslot wechseln">
                <input type="checkbox"
                       checked="@slot.IsAlt"
                       aria-label="Halber Tag"
                       @onchange="() => ToggleAltSlot(area.Id)" />
                <span class="slider round"></span>
            </label>
        </div>;

    private RenderFragment RegisterAction(Area area, SlotInfo slot, string label) =>
        @<text>
            @if (registeringAreaId == area.Id)
            {
                <div class="btn-loading btn-loading--register">
                    <span class="btn-spinner btn-spinner--white"></span>
                    <span>Wird registriert...</span>
                </div>
            }
            else
            {
                <button class="register-btn"
                        @onclick="() => OpenConfirmModal(area)"
                        disabled="@(registeringAreaId.HasValue || !slot.CanRegister)">
                    @label
                </button>
            }
        </text>;

    // ── Hinweis-Text pro Area-Karte ───────────────────────────────────────────
    private string GetRegistrationNote(Area area)
    {
        var isAltActive = useAltSlot.GetValueOrDefault(area.Id, false);

        if (isAltActive)
        {
            if (canRegisterAlt.TryGetValue(area.Id, out var canAlt) && canAlt)
                return string.Empty;

            var altReg = altRegistrations.GetValueOrDefault(area.Id, 0);
            var altCap = area.AlternativeMaxCapacity ?? 0;
            if (altReg >= altCap)
                return "Bereich ist bereits belegt.";

            if (area.AreaTemplate?.AreaCategory?.Name == "Verkauf")
                return "Nur eine Verkauf-Registrierung ist möglich.";

            if (area.AreaTemplate?.AreaCategory?.Name == "Kuchen")
                return "Pro Tag ist nur eine Kuchen-Anmeldung möglich.";

            return "Registrierung aktuell nicht möglich.";
        }

        // ── Ganztags-Slot ─────────────────────────────────────────────────────
        if (canRegister.TryGetValue(area.Id, out var can) && can)
            return string.Empty;

        var minAge = area.AreaTemplate?.MinAge ?? 0;
        if (minAge > 0 && selectedPersonAge.HasValue && selectedPersonAge.Value < minAge)
            return $"Mindestalter {minAge} Jahre erforderlich.";

        if (currentRegistrations.TryGetValue(area.Id, out var current) && current >= area.MaxCapacity)
            return "Bereich ist bereits belegt.";

        if (area.IsSpontaneous)
            return "Du bist hier bereits angemeldet.";

        if (area.AreaTemplate?.AreaCategory?.Name == "Verkauf")
            return "Nur eine Verkauf-Registrierung ist möglich.";

        if (area.AreaTemplate?.AreaCategory?.Name == "Kuchen")
            return "Pro Tag ist nur eine Kuchen-Anmeldung möglich.";

        return "Registrierung aktuell nicht möglich.";
    }

    // ── Hilfsmethoden ─────────────────────────────────────────────────────────
    private int CalculateAge(DateTime birthDate, DateTime referenceDate)
    {
        var age = referenceDate.Year - birthDate.Year;
        if (referenceDate < birthDate.AddYears(age)) age--;
        return age;
    }

    private string GetGermanDayName(string dateString)
    {
        if (DateTime.TryParse(dateString, out var date))
        {
            var culture = new System.Globalization.CultureInfo("de-DE");
            return culture.DateTimeFormat.GetDayName(date.DayOfWeek);
        }
        return string.Empty;
    }
