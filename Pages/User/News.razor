@page "/news"
@using FlomiApp.Data.Models
@inject INewsService NewsService

<link rel="stylesheet" href="/css/register.css" />

<Seo Title="News" Description="Aktuelle Mitteilungen und Infos rund um den Flohmarkt der Pfadi Morgarten: Termine, Annahme der Ware und alles, was Helfer/innen wissen müssen." />

<div class="register-page">

    <section class="register-hero">
        <div class="register-hero__content">
            <span class="register-hero__badge">Informationen</span>
            <h1>News & Mitteilungen</h1>
            <p>Alle aktuellen und vergangenen Meldungen rund um den Flomi.</p>
        </div>
    </section>

    @if (news == null)
    {
        <div class="state-card state-card--info">
            <div class="state-card__icon">⏳</div>
            <div class="state-card__content"><h3>Wird geladen...</h3></div>
        </div>
    }
    else if (!news.Any())
    {
        <div class="state-card state-card--empty">
            <div class="state-card__icon">📭</div>
            <div class="state-card__content">
                <h3>Keine Meldungen</h3>
                <p>Aktuell sind keine Mitteilungen vorhanden.</p>
            </div>
        </div>
    }
    else
    {
        <div class="news-archive">
            @{ var isFirst = true; }
            @foreach (var item in news)
            {
                <article class="news-card @(isFirst ? "news-card--latest" : "")">
                    <div class="news-card__header">
                        <span class="news-card__header-icon">📅</span>
                        <span class="news-card__date">
                            @item.CreatedAt.ToString("dddd, dd. MMMM yyyy",
                                new System.Globalization.CultureInfo("de-CH"))
                        </span>
                    </div>
                    <div class="news-card__body @(item.Images.Count > 0 ? "news-card__body--media" : "")">
                        @if (item.Images.Count > 0)
                        {
                            <div class="news-gallery">
                                @for (var i = 0; i < item.Images.Count; i++)
                                {
                                    var img    = item.Images[i];
                                    var start  = i;
                                    var images = item.Images;
                                    var title  = item.Title;
                                    <a href="/news-images/@img.Id" target="_blank" rel="noopener" class="news-gallery__item"
                                       title="Bild vergrössern"
                                       @onclick="() => lightbox.Open(images, start, title)" @onclick:preventDefault>
                                        <img src="/news-images/@img.Id?thumb=true" alt="Bild zu «@item.Title»" loading="lazy" />
                                    </a>
                                }
                            </div>
                        }
                        <div class="news-card__text">
                            <h2 class="news-card__title">@item.Title</h2>
                            <p class="news-card__content">@item.Content</p>
                        </div>
                    </div>
                </article>
                isFirst = false;
            }
        </div>
    }

</div>

<ImageLightbox @ref="lightbox" />

@code {
    private List<NewsItem>? news;
    private ImageLightbox   lightbox = null!;

    protected override async Task OnInitializedAsync()
    {
        news = await NewsService.GetPublishedAsync();
    }
}
