@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace FlomiApp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@inject IConfiguration Configuration
@{
    var designTheme = FlomiApp.Helpers.DesignTheme.FromConfiguration(Configuration);
    var themeStylesheet = FlomiApp.Helpers.DesignTheme.StylesheetPath(designTheme);
}

<!DOCTYPE html>
<html lang="de" data-brand="@designTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="@FlomiApp.Helpers.DesignTheme.ThemeColor(designTheme)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="FlomiApp" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true" />
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
    <link href="~/FlomiApp.styles.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
    @if (themeStylesheet != null)
    {
        <link rel="stylesheet" href="~/@themeStylesheet" asp-append-version="true" />
    }
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon.png" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/img/icon-192.png" asp-append-version="true" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            Es ist ein Fehler aufgetreten. Bitte lade die Seite neu.
        </environment>
        <environment include="Development">
            Unbehandelte Ausnahme – Details in den Entwicklertools des Browsers.
        </environment>
        <a href="" class="reload">Neu laden</a>
        <a class="dismiss" role="button" aria-label="Hinweis schliessen">🗙</a>
    </div>

    @* Eigene Anzeige bei Verbindungsunterbruch statt des englischen Blazor-Fensters. Blazor setzt nur
       die Klassen components-reconnect-*; Ablauf (Leiste → Karte, «Wieder verbunden») in js/reconnect.js *@
    <div id="components-reconnect-modal" class="reconnect" role="status" aria-live="polite">
        <div class="reconnect__bar">
            <span class="reconnect__spinner" aria-hidden="true"></span>
            <span>📶 Verbindung kurz unterbrochen – einen Moment …</span>
        </div>
        <div class="reconnect__ok">✓ Wieder verbunden</div>
        <div class="reconnect__backdrop">
            <div class="reconnect__card">
                <img src="/img/pfadi_logo.png" alt="" class="reconnect__logo" />
                <div class="reconnect__waiting">
                    <h2>Verbindung wird wiederhergestellt</h2>
                    <p class="reconnect__attempt">
                        <span class="reconnect__spinner" aria-hidden="true"></span>
                        Versuch <span id="components-reconnect-current-attempt">1</span>
                    </p>
                    <p>Keine Sorge: Deine Anmeldungen sind gespeichert.</p>
                </div>
                <div class="reconnect__failed">
                    <h2>Verbindung verloren</h2>
                    <p>Die App wurde vielleicht gerade aktualisiert oder das Netz ist weg. Deine Anmeldungen sind gespeichert.</p>
                    <button type="button" class="reconnect__btn" data-reconnect-retry>Erneut verbinden</button>
                </div>
                <p class="reconnect__offline">📶 Du bist offline – prüfe WLAN oder mobile Daten.</p>
                <button type="button" class="reconnect__btn reconnect__btn--ghost" data-reconnect-reload>Seite neu laden</button>
            </div>
        </div>
    </div>

    <script src="~/js/themeManager.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script src="~/js/charts.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
    <script src="~/js/qrscanner.js" asp-append-version="true"></script>
    <script src="~/js/scrollHelper.js" asp-append-version="true"></script>
    <script src="~/js/downloadFile.js" asp-append-version="true"></script>
    <script src="~/js/passkey.js" asp-append-version="true"></script>
    <script src="~/js/reconnect.js" asp-append-version="true"></script>
    <script src="_framework/blazor.server.js"></script>
</body>
</html>
