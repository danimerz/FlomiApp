<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-FlomiApp-cae2207e-3c7f-404f-8f14-5012a2de13bb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Web-SDK globbt standardmässig rekursiv — Testprojekt-Unterordner ausschliessen -->
  <ItemGroup>
    <Compile Remove="FlomiApp.Tests/**" />
    <Content Remove="FlomiApp.Tests/**" />
    <EmbeddedResource Remove="FlomiApp.Tests/**" />
    <None Remove="FlomiApp.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <!-- EF-Core-Pakete bleiben auf 9.0.x: Pomelo 9 erlaubt nur EF Core 9. Auf 10 heben, sobald Pomelo 10 erscheint. -->
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.21" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.21">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Nur fürs Scaffolding, nicht mit der App ausliefern -->
    <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- SkiaSharp (MIT) verkleinert die Möbelfotos; NativeAssets.Linux liefert libSkiaSharp für den Linux-Server mit.
         ImageSharp 4 bräuchte im Release-Build einen Lizenzschlüssel, 3.x hat offene Sicherheitslücken. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
    <!-- Transitiv über MailKit/MimeKit; 10.0.0 hat bekannte Sicherheitslücken (CVE-2026-84008, CVE-2026-70162) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- SkiaSharp bringt native Bibliotheken für ~17 Plattformen mit (Windows inkl. 81-MB-PDBs) – das
       Publish-ZIP wurde dadurch grösser als die 100 MB, die Cloudflare beim Deploy-Upload erlaubt.
       Der Server läuft auf Linux: nur linux-x64 (und arm64 als Reserve) ins Publish übernehmen. -->
  <Target Name="TrimSkiaSharpNativeAssets" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_SkiaNativeToDrop Include="@(ResolvedFileToPublish)"
                         Condition="$([System.String]::Copy('%(Filename)').StartsWith('libSkiaSharp'))
                                    And !$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('runtimes/linux-x64/'))
                                    And !$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('runtimes/linux-arm64/'))" />
      <ResolvedFileToPublish Remove="@(_SkiaNativeToDrop)" />
    </ItemGroup>
  </Target>

</Project>
