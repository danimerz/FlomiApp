@page
@model LoginWithRecoveryCodeModel

@{
    ViewData["Title"] = "Recovery-Code";
}

<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
<style>
    .register-form { display: flex; flex-direction: column; gap: 1.25rem; }
    .form-group { display: flex; flex-direction: column; gap: .45rem; }
    .form-group label { font-size: .92rem; font-weight: 700; color: #374151; }
    .form-control-modern {
        display: block; width: 100%; height: 3.35rem; padding: 0 1rem;
        border: 1px solid #d1d5db; border-radius: 14px; background: #f9fafb;
        color: #111827; font-size: 1rem; font-family: "Courier New", monospace;
        box-sizing: border-box; transition: border-color .2s, box-shadow .2s;
    }
    .form-control-modern:focus {
        outline: none; border-color: var(--brand-600);
        box-shadow: 0 0 0 4px rgba(var(--brand-600-rgb), .12); background: #fff;
    }
    .register-submit-btn {
        display: flex; align-items: center; justify-content: center; gap: .5rem;
        width: 100%; padding: 1rem 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, var(--brand-700) 0%, var(--brand-600) 100%);
        color: #fff; font-size: 1rem; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 18px rgba(var(--brand-600-rgb), .28);
        transition: filter .18s, transform .18s; margin-top: .5rem;
    }
    .register-submit-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
    .register-validation { color: #dc2626; font-size: .88rem; margin-bottom: .5rem; }
    .register-field-error { color: #dc2626; font-size: .82rem; margin-top: .2rem; }
    .fp-back { display: inline-flex; align-items: center; gap: .4rem; margin-top: 1rem;
               font-size: .88rem; font-weight: 600; color: var(--brand-600); text-decoration: none; }
</style>

<div class="register-page">
    <section class="register-hero">
        <div class="register-hero__content">
            <span class="register-hero__badge">Notfall-Zugang</span>
            <h1>Recovery-Code</h1>
            <p>Gib einen deiner 10 Recovery-Codes ein, die du bei der 2FA-Einrichtung erhalten hast.</p>
        </div>
    </section>

    <section class="register-card">
        <div class="register-card__header">
            <div class="register-card__topline">Anmeldung</div>
            <h2>Code eingeben</h2>
            <p>Jeder Code funktioniert nur einmal.</p>
        </div>

        <div class="register-card__body">
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="register-form">
                <div asp-validation-summary="ModelOnly" class="register-validation"></div>

                <div class="form-group">
                    <label asp-for="Input.RecoveryCode"></label>
                    <input asp-for="Input.RecoveryCode" class="form-control-modern" autocomplete="off" />
                    <span asp-validation-for="Input.RecoveryCode" class="register-field-error"></span>
                </div>

                <button type="submit" class="register-submit-btn">
                    ✅ Anmelden
                </button>
            </form>

            <a href="/Identity/Account/Login" class="fp-back">← Zurück zum Login</a>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
