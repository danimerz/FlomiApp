@page
@model LoginModel

@{
    ViewData["Title"] = "Anmelden";
    ViewData["Description"] = "Bei der Flomi App anmelden, um deine Einsätze am Flohmarkt der Pfadi Morgarten zu sehen und zu verwalten.";
}

<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />

<div class="register-page">
    <section class="register-hero">
        <div class="register-hero__content">
            <span class="register-hero__badge">Willkommen zurück</span>
            <h1>Anmelden</h1>
            <p>
                Melde dich mit deinem Konto bei der FlomiApp an, um auf Einsätze und Veranstaltungen zuzugreifen.
            </p>
        </div>
    </section>

    <section class="register-card">
        <div class="register-card__header">
            <div class="register-card__topline">Benutzerzugang</div>
            <h2>Kontoanmeldung</h2>
            <p>@(Model.ExternalLogins?.Count > 0
                ? "Melde dich mit einem bestehenden Konto oder mit E-Mail und Passwort an."
                : "Gib deine E-Mail-Adresse und dein Passwort ein, um dich anzumelden.")</p>
        </div>

        <div class="register-card__body">
            @* Passkey: erscheint nur, wenn der Browser Passkeys kann (wwwroot/js/passkey.js) *@
            <div class="passkey-login" data-passkey-login hidden>
                <form method="post" asp-page-handler="Passkey" asp-route-returnUrl="@Model.ReturnUrl">
                    <input type="hidden" name="credentialJson" data-passkey-credential />
                    <input type="hidden" name="rememberMe" value="false" data-passkey-remember />
                    <button type="button" class="social-btn passkey-btn" data-passkey-start>
                        <span class="social-btn__icon passkey-btn__icon" aria-hidden="true">🔑</span>
                        <span>Mit Passkey anmelden</span>
                    </button>
                </form>
                <p class="passkey-login__error" role="alert" data-passkey-error hidden></p>
                @if (!(Model.ExternalLogins?.Count > 0))
                {
                    <div class="social-divider"><span>oder mit E-Mail</span></div>
                }
            </div>

            <partial name="_ExternalLoginButtons"
                     model='new ExternalLoginButtonsModel(Model.ExternalLogins ?? new List<Microsoft.AspNetCore.Authentication.AuthenticationScheme>(), Model.ReturnUrl,
                         "oder mit E-Mail",
                         "Admin-Konten melden sich mit Passkey oder mit E-Mail, Passwort und 2FA an.")' />

            <form id="account" method="post" class="register-form">
                <div asp-validation-summary="ModelOnly" class="register-validation"></div>

                <div class="register-grid register-grid--full">
                    <div class="register-field">
                        <label asp-for="Input.Email" class="register-label"></label>
                        <input asp-for="Input.Email"
                               class="register-input"
                               autocomplete="username webauthn"
                               aria-required="true"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="register-error"></span>
                    </div>
                </div>

                <div class="register-grid register-grid--full">
                    <div class="register-field">
                        <label asp-for="Input.Password" class="register-label"></label>
                        <input asp-for="Input.Password"
                               type="password"
                               class="register-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Passwort" />
                        <span asp-validation-for="Input.Password" class="register-error"></span>
                    </div>
                </div>

                <div class="register-grid register-grid--full">
                    <div class="register-field">
                        <div class="register-checkbox">
                            <input asp-for="Input.RememberMe" />
                            <span>Angemeldet bleiben</span>
                        </div>
                        <span asp-validation-for="Input.RememberMe" class="register-error"></span>
                    </div>
                </div>

                <div class="register-actions">
                    <button id="login-submit" type="submit" class="register-button">Anmelden</button>
                </div>

                <div class="register-links">
                    <p>
                        <a id="forgot-password" asp-page="./ForgotPassword">🔑 Passwort vergessen?</a>
                    </p>
                    <p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Neuen Account erstellen</a>
                    </p>
                    <p>
                        <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Bestätigungs-E-Mail erneut senden</a>
                    </p>
                </div>
            </form>

        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/passkey.js" asp-append-version="true"></script>
}