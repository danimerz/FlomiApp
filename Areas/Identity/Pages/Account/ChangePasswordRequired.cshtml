@page
@model ChangePasswordRequiredModel

@{
    ViewData["Title"] = "Passwort ändern";
}

<link rel="stylesheet" href="/css/register.css" />
<style>
    .register-form { display: flex; flex-direction: column; gap: 1.25rem; }
    .form-group { display: flex; flex-direction: column; gap: .45rem; }
    .form-group label { font-size: .92rem; font-weight: 700; color: #374151; }
    .form-control-modern {
        display: block; width: 100%; height: 3.35rem; padding: 0 1rem;
        border: 1px solid #d1d5db; border-radius: 14px; background: #f9fafb;
        color: #111827; font-size: .97rem; box-sizing: border-box;
        transition: border-color .2s, box-shadow .2s;
    }
    .form-control-modern:focus {
        outline: none; border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37,99,235,.12); background: #fff;
    }
    .register-submit-btn {
        display: flex; align-items: center; justify-content: center; gap: .5rem;
        width: 100%; padding: 1rem 1.5rem; border: none; border-radius: 16px;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
        color: #fff; font-size: 1rem; font-weight: 800; cursor: pointer;
        box-shadow: 0 4px 18px rgba(37,99,235,.28);
        transition: filter .18s, transform .18s; margin-top: .5rem;
    }
    .register-submit-btn:hover { filter: brightness(1.06); transform: translateY(-1px); }
    .register-validation { color: #dc2626; font-size: .88rem; margin-bottom: .5rem; }
    .register-field-error { color: #dc2626; font-size: .82rem; margin-top: .2rem; }
    .tfa-warning {
        background: #fef9c3; border: 1px solid #fde68a; color: #854d0e;
        border-radius: 10px; padding: .75rem 1rem; font-size: .88rem; font-weight: 600;
        margin-bottom: 1.25rem;
    }
</style>

<div class="register-page">
    <section class="register-hero">
        <div class="register-hero__content">
            <span class="register-hero__badge">Sicherheit</span>
            <h1>Passwort ändern</h1>
            <p>Dieses Konto wurde mit einem automatisch generierten Passwort erstellt. Bitte lege jetzt ein eigenes fest.</p>
        </div>
    </section>

    <section class="register-card">
        <div class="register-card__header">
            <div class="register-card__topline">Erstanmeldung</div>
            <h2>Neues Passwort festlegen</h2>
        </div>

        <div class="register-card__body">
            <div class="tfa-warning">
                ⚠️ Du kannst die App erst normal nutzen, nachdem du ein eigenes Passwort gesetzt hast.
            </div>

            <form method="post" class="register-form">
                <div asp-validation-summary="ModelOnly" class="register-validation"></div>

                <div class="form-group">
                    <label asp-for="Input.CurrentPassword">Aktuelles (generiertes) Passwort</label>
                    <input asp-for="Input.CurrentPassword" type="password" class="form-control-modern" autocomplete="current-password" />
                    <span asp-validation-for="Input.CurrentPassword" class="register-field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.NewPassword">Neues Passwort</label>
                    <input asp-for="Input.NewPassword" type="password" class="form-control-modern" autocomplete="new-password" placeholder="Mindestens 6 Zeichen" />
                    <span asp-validation-for="Input.NewPassword" class="register-field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Neues Passwort bestätigen</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control-modern" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="register-field-error"></span>
                </div>

                <button type="submit" class="register-submit-btn">
                    ✅ Passwort setzen
                </button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
